--- /dev/null
+++ b/src/mali_x11.inc
@@ -0,0 +1,184 @@
+/* X11 client/window compatibility only. No changes to Vulkan rendering/output.
+ * Uses Gamescope's pinned wlroots XWM. Displays one focused client window through
+ * the existing SHM import; bootstrapping, modal windows and replacement are allowed.
+ * No Gamescope game/scaler capability properties are advertised here. */
+struct MaliXWindow {
+    wlr_xwayland_surface *window = nullptr;
+    bool dirty = false, presented = false;
+    wl_listener associate{}, dissociate{}, destroy{}, configure{}, activate{}, fullscreen{};
+    wl_listener map{}, unmap{}, commit{};
+};
+static std::vector<MaliXWindow *> xWindows;
+static bool x11Stopping = false;
+static void X11Unlisten(wl_listener &listener) {
+    if (listener.link.next) { wl_list_remove(&listener.link); listener.link = {}; }
+}
+static bool X11Eligible(MaliXWindow *w) {
+    return w->window->surface && w->window->surface->mapped &&
+        (!w->window->override_redirect ||
+         wlr_xwayland_surface_override_redirect_wants_focus(w->window));
+}
+static void X11Select(MaliXWindow *chosen = nullptr) {
+    if (x11Stopping) return;
+    if (chosen && !X11Eligible(chosen)) chosen = nullptr;
+    if (!chosen) for (auto it = xWindows.rbegin(); it != xWindows.rend(); ++it)
+        if (X11Eligible(*it)) { chosen = *it; break; }
+    wlr_surface *surface = chosen ? chosen->window->surface : nullptr;
+    if (surface == server.surface) return;
+    if (server.surface) {
+        auto previous = wlr_xwayland_surface_try_from_wlr_surface(server.surface);
+        if (previous) wlr_xwayland_surface_activate(previous, false);
+    }
+    wlr_seat_pointer_clear_focus(server.seat);
+    wlr_seat_keyboard_clear_focus(server.seat);
+    server.surface = surface;
+    server.pending = surface && wlr_surface_has_buffer(surface);
+    if (chosen) {
+        xWindows.erase(std::find(xWindows.begin(), xWindows.end(), chosen));
+        xWindows.push_back(chosen);
+        wlr_xwayland_surface_activate(chosen->window, true);
+        wlr_xwayland_surface_restack(chosen->window, nullptr, XCB_STACK_MODE_ABOVE);
+        wlr_surface_send_enter(surface, server.x11Output);
+        wlr_seat_keyboard_notify_enter(server.seat, surface, nullptr, 0, &server.keyboard->modifiers);
+        std::printf("Mali Steam X11 focus window=0x%x client-pid=%d; visibility not yet proven\n",
+            chosen->window->window_id, int(chosen->window->pid));
+    }
+}
+static void X11Commit(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, commit);
+    if (wlr_surface_has_buffer(w->window->surface)) {
+        w->dirty = true;
+        if (server.surface == w->window->surface) { server.pending = true; ++server.commits; }
+    }
+}
+static void X11Map(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, map);
+    w->dirty = true;
+    X11Select(w);
+}
+static void X11Unmap(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, unmap);
+    if (server.surface == w->window->surface) X11Select();
+}
+static void X11Dissociate(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, dissociate);
+    if (server.surface == w->window->surface) {
+        wlr_seat_pointer_clear_focus(server.seat); wlr_seat_keyboard_clear_focus(server.seat);
+        server.surface = nullptr; server.pending = false;
+    }
+    X11Unlisten(w->map); X11Unlisten(w->unmap); X11Unlisten(w->commit);
+}
+static void X11Associate(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, associate);
+    w->map.notify = X11Map; w->unmap.notify = X11Unmap; w->commit.notify = X11Commit;
+    wl_signal_add(&w->window->surface->events.map, &w->map);
+    wl_signal_add(&w->window->surface->events.unmap, &w->unmap);
+    wl_signal_add(&w->window->surface->events.commit, &w->commit);
+}
+static void X11Destroy(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, destroy);
+    X11Dissociate(&w->dissociate, nullptr);
+    X11Unlisten(w->associate); X11Unlisten(w->dissociate); X11Unlisten(w->destroy);
+    X11Unlisten(w->configure); X11Unlisten(w->activate); X11Unlisten(w->fullscreen);
+    xWindows.erase(std::find(xWindows.begin(), xWindows.end(), w)); delete w;
+    X11Select();
+}
+static void X11Configure(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, configure);
+    // C8A is a single focused UI, not a desktop/game window compositor.
+    wlr_xwayland_surface_configure(w->window, 0, 0, g_nPreferredOutputWidth, g_nPreferredOutputHeight);
+}
+static void X11Activate(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, activate);
+    X11Select(w);
+}
+static void X11Fullscreen(wl_listener *listener, void *) {
+    MaliXWindow *w = wl_container_of(listener, w, fullscreen);
+    wlr_xwayland_surface_set_fullscreen(w->window, true);
+    X11Configure(&w->configure, nullptr);
+}
+static void X11Created(wl_listener *, void *data) {
+    auto w = new MaliXWindow{}; w->window = static_cast<wlr_xwayland_surface *>(data);
+    xWindows.push_back(w);
+    w->associate.notify = X11Associate; w->dissociate.notify = X11Dissociate; w->destroy.notify = X11Destroy;
+    w->configure.notify = X11Configure; w->activate.notify = X11Activate; w->fullscreen.notify = X11Fullscreen;
+    wl_signal_add(&w->window->events.associate, &w->associate);
+    wl_signal_add(&w->window->events.dissociate, &w->dissociate);
+    wl_signal_add(&w->window->events.destroy, &w->destroy);
+    wl_signal_add(&w->window->events.request_configure, &w->configure);
+    wl_signal_add(&w->window->events.request_activate, &w->activate);
+    wl_signal_add(&w->window->events.request_fullscreen, &w->fullscreen);
+    if (!w->window->override_redirect) X11Configure(&w->configure, nullptr);
+}
+static void X11Ready(wl_listener *, void *) {
+    server.x11Ready = true;
+    wlr_xwayland_set_seat(server.xwayland, server.seat);
+    std::printf("Mali Steam Xwayland ready: DISPLAY=%s; SHM/software client; no proxy ICD for Steam\n", server.xwayland->display_name);
+}
+static bool StartX11(wlr_compositor *compositor) {
+    x11Stopping = false;
+    wlr_log_init(WLR_ERROR, nullptr); // keep Xwayland startup/crash stderr visible
+    // Advertise geometry to Xwayland/RandR only. No output buffers/rendering here.
+    server.x11Backend = wlr_headless_backend_create(wl_display_get_event_loop(server.display));
+    if (!server.x11Backend) return false;
+    server.x11Output = wlr_headless_add_output(server.x11Backend, g_nPreferredOutputWidth, g_nPreferredOutputHeight);
+    if (!server.x11Output) return false;
+    wlr_output_state state; wlr_output_state_init(&state);
+    wlr_output_state_set_enabled(&state, true);
+    wlr_output_state_set_custom_mode(&state, g_nPreferredOutputWidth, g_nPreferredOutputHeight, g_nOutputRefresh);
+    bool ok = wlr_output_commit_state(server.x11Output, &state);
+    wlr_output_state_finish(&state);
+    if (!ok || !wlr_backend_start(server.x11Backend)) return false;
+    wlr_output_create_global(server.x11Output, server.display);
+    // Verified Xwayland switch: disables glamor AND DRI3, forcing SHM client buffers.
+    setenv("XWAYLAND_NO_GLAMOR", "1", 1);
+    server.xwayland = wlr_xwayland_create(server.display, compositor, false);
+    if (!server.xwayland) return false;
+    server.x11ReadyListener.notify = X11Ready; server.x11Created.notify = X11Created;
+    wl_signal_add(&server.xwayland->events.ready, &server.x11ReadyListener);
+    wl_signal_add(&server.xwayland->events.new_surface, &server.x11Created);
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(10);
+    while (!server.x11Ready && !stopped && !failed && std::chrono::steady_clock::now() < deadline) {
+        if (wl_event_loop_dispatch(wl_display_get_event_loop(server.display), 10) < 0) return false;
+        gamescope::IBackend::Get()->PollState(); wl_display_flush_clients(server.display);
+    }
+    if (!server.x11Ready) std::fputs("Mali Steam Xwayland readiness failed/timed out before client launch\n", stderr);
+    return server.x11Ready && !stopped && !failed;
+}
+static void X11Presented() {
+    for (auto w : xWindows) {
+        auto surface = w->window->surface;
+        if (surface == server.surface && !w->presented) {
+            w->presented = true;
+            std::printf("Mali Steam X11 client surface presented: window=0x%x client-pid=%d; Steam UI/sign-in needs visual confirmation\n",
+                w->window->window_id, int(w->window->pid));
+        }
+        if (surface == server.surface) w->dirty = false;
+    }
+}
+static void X11IdleCallbacks() {
+    // A hidden bootstrap/helper window must not stall when the focused UI is idle.
+    // This acknowledges client callbacks only; it does not publish/render output.
+    static std::chrono::steady_clock::time_point next{};
+    auto now = std::chrono::steady_clock::now();
+    if (now < next) return;
+    next = now + std::chrono::nanoseconds(1000000000000ull / g_nOutputRefresh);
+    timespec time{}; clock_gettime(CLOCK_MONOTONIC, &time);
+    for (auto w : xWindows) {
+        auto surface = w->window->surface;
+        if (surface && surface != server.surface && w->dirty) {
+            wlr_surface_send_frame_done(surface, &time); w->dirty = false;
+        }
+    }
+    wl_display_flush_clients(server.display);
+}
+static void StopX11() {
+    x11Stopping = true;
+    X11Unlisten(server.x11ReadyListener); X11Unlisten(server.x11Created);
+    if (server.xwayland) wlr_xwayland_destroy(server.xwayland);
+    server.xwayland = nullptr;
+    // XWM destruction emits surface destroy; defensively detach remaining listeners.
+    while (!xWindows.empty()) X11Destroy(&xWindows.back()->destroy, nullptr);
+    if (server.x11Backend) wlr_backend_destroy(server.x11Backend);
+    server.x11Backend = nullptr; server.x11Output = nullptr;
+}
