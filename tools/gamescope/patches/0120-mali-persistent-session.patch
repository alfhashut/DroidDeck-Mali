+gamescope::OwningRc<CVulkanTexture> mali_wayland_next() {
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (!server.pending && !server.removed && std::chrono::steady_clock::now() < deadline) {
+        if (!ServerDispatch(50)) return nullptr;
+    }
+    if (!server.pending || !server.surface || server.error) { std::fprintf(stderr, "Wayland commit failed: pending=%u surface removed=%u commits=%u\n", server.pending, server.removed, server.commits); return nullptr; }
