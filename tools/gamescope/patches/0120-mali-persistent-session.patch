+#pragma once
+#include <array>
+/* Diagnostic ownership is separate from Vulkan layout/queue ownership. A GPU
+ * fence alone cannot move Android -> Free: only the consumer release RPC can. */
+class MaliOutputPool {
+public:
+    enum State { Free, Rendering, Ready, Android };
+    int acquire(unsigned start) {
+        for (unsigned n = 0; n < states.size(); ++n) {
+            unsigned i = (start + n) % states.size();
+            if (states[i] == Free) { states[i] = Rendering; return int(i); }
+        }
+        return -1; // backpressure: caller must not record work without a slot
+    }
+    bool ready(unsigned i) { return transition(i, Rendering, Ready); }
+    bool presented(unsigned i) { return transition(i, Ready, Android); }
+    bool released(unsigned i) { return transition(i, Android, Free); }
+    bool free(unsigned i) const { return i < states.size() && states[i] == Free; }
+    bool androidOwned(unsigned i) const { return i < states.size() && states[i] == Android; }
+private:
+    bool transition(unsigned i, State from, State to) {
+        if (i >= states.size() || states[i] != from) return false;
+        states[i] = to; return true;
+    }
+    std::array<State, 3> states{};
+};
--- a/src/mali_session.inc
+++ b/src/mali_session.inc
@@ -0,0 +1,258 @@
+/* Compiled inside the actual renderer TU; no replacement renderer or shader. */
+#include "mali_session_wayland.hpp"
+#include "backends.h"
+#include "mali_output_pool.hpp"
+#include <chrono>
+#include <thread>
+#include <csignal>
+
+namespace {
+struct MaliSession {
+    struct Slot { dd_interop_output ahb{}; gamescope::OwningRc<CVulkanTexture> texture; unsigned lastFrame = 0; } slots[3];
+    MaliOutputPool ownership;
+    PFN_vkDroidDeckInteropTEST interop = nullptr;
+    PFN_vkDroidDeckSessionTEST transport = nullptr;
+    VkBuffer readback = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    bool coherent = false, wayland = false;
+    bool consumerBegun = false, stopAttempted = false;
+    unsigned releaseTimeouts = 0;
+    unsigned maxOwned = 0;
+    unsigned frame = 0, limit = 300, rendered = 0, presented = 0, released = 0, verified = 0, late = 0;
+    uint64_t start = 0, last = 0;
+};
+static MaliSession *s_session;
+static volatile sig_atomic_t s_sessionStop;
+static void MaliStop(int) { s_sessionStop = 1; }
+static void MaliRequire(bool ok, const char *operation) {
+    if (!ok) g_device.FailMaliDiagnostic(operation, s_maliLastResult == VK_SUCCESS ? VK_ERROR_INITIALIZATION_FAILED : s_maliLastResult);
+}
+static dd_interop_output MaliInterop(uint32_t op, dd_interop_input input = {}) {
+    dd_interop_output out{};
+    MaliRequire(MaliResult(s_session->interop(g_device.device(), op, &input, &out), "session interop"), "session interop"); return out;
+}
+static dd_session_output MaliTransport(uint32_t op, dd_interop_input input = {}) {
+    dd_session_output out{};
+    MaliRequire(MaliResult(s_session->transport(g_device.device(), op, &input, &out), "persistent consumer RPC"), "persistent consumer RPC"); return out;
+}
+static void MaliReleased(uint32_t token) {
+    if (!token) return;
+    for (auto &slot : s_session->slots) if (slot.ahb.token == token) {
+        MaliRequire(s_session->ownership.released(&slot - s_session->slots), "unexpected Android release token"); ++s_session->released; return;
+    }
+    MaliRequire(false, "Android release token outside output pool");
+}
+static VkResult MaliStopOutput() {
+    auto &s = *s_session;
+    if (!s.consumerBegun || s.stopAttempted) return s.releaseTimeouts ? VK_TIMEOUT : VK_SUCCESS;
+    s.stopAttempted = true; // never submit another frame or restart the wait
+    unsigned outstanding = 0;
+    for (unsigned i = 0; i < 3; ++i) outstanding += s.ownership.androidOwned(i);
+    dd_interop_input input{}; dd_session_output output{};
+    VkResult result = s.transport(g_device.device(), DD_SESSION_END, &input, &output);
+    if (result == VK_SUCCESS) MaliReleased(output.token);
+    if (result == VK_TIMEOUT) {
+        ++s.releaseTimeouts;
+        for (unsigned i = 0; i < 3; ++i) if (s.ownership.androidOwned(i))
+            std::fprintf(stderr, "Android release wait TIMEOUT: buffer token=%u frame=%u state=ANDROID_OWNED outstanding releases=%u presented=%u released=%u; native broker logs contain last sync token/fence state\n",
+                s.slots[i].ahb.token, s.slots[i].lastFrame, outstanding, s.presented, s.released);
+    }
+    std::printf("Android release wait: outstanding at stop=%u released=%u timed out=%u; release timeouts=%u VkResult=%d\n",
+        outstanding, result == VK_SUCCESS && output.token ? 1u : 0u, result == VK_TIMEOUT ? outstanding : 0u, s.releaseTimeouts, int(result));
+    return result;
+}
+static void MaliExpected(unsigned frame, bool client, unsigned x, unsigned y, uint8_t p[4]) {
+    p[0] = p[1] = p[2] = 0; p[3] = 255;
+    unsigned left = client ? (frame * 3) % 193 : 16 + (frame * 3) % 97;
+    unsigned top = client ? (frame * 5) % 193 : 64;
+    unsigned side = client ? 64 : 128;
+    if (x < left || y < top || x >= left + side || y >= top + side) return;
+    if (client) {
+        unsigned color = (frame / 30) % 4;
+        if (color < 3) p[color] = 255; else p[0] = p[1] = p[2] = 255;
+    } else if (y < top + 64) p[x < left + 64 ? 0 : 1] = 255;
+    else if (x < left + 64) p[2] = 255; else p[0] = p[1] = p[2] = 255;
+}
+static void MaliVerify() {
+    void *mapped = nullptr;
+    MaliRequire(MaliResult(g_device.vk.MapMemory(g_device.device(), s_session->memory, 0, VK_WHOLE_SIZE, 0, &mapped), "selected-frame readback map"), "selected-frame readback map");
+    if (!s_session->coherent) {
+        auto invalidate = (PFN_vkInvalidateMappedMemoryRanges)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkInvalidateMappedMemoryRanges");
+        VkMappedMemoryRange range{ .sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, .memory = s_session->memory, .size = VK_WHOLE_SIZE };
+        MaliRequire(invalidate && MaliResult(invalidate(g_device.device(), 1, &range), "selected-frame invalidate"), "selected-frame invalidate");
+    }
+    unsigned bad = 0; uint64_t hash = 14695981039346656037ull;
+    for (unsigned y = 0; y < 256; ++y) for (unsigned x = 0; x < 256; ++x) {
+        uint8_t expected[4]; MaliExpected(s_session->frame, s_session->wayland, x, y, expected);
+        auto pixel = static_cast<const uint8_t *>(mapped) + (y * 256 + x) * 4;
+        bad += std::memcmp(pixel, expected, 4) != 0;
+        for (unsigned k = 0; k < 4; ++k) hash = (hash ^ pixel[k]) * 1099511628211ull;
+    }
+    g_device.vk.UnmapMemory(g_device.device(), s_session->memory);
+    std::printf("selected frame=%u actual AHB GPU readback mismatches=%u hash=%llu\n", s_session->frame, bad, (unsigned long long)hash);
+    MaliRequire(!bad, "changing-frame GPU pixel verification"); ++s_session->verified;
+}
+static void MaliCheckCleanup() {
+    auto stats = MaliTransport(DD_SESSION_STATS);
+    MaliRequire(stats.presented == s_session->presented && stats.released == s_session->released && stats.presented == stats.released, "native presentation/release accounting");
+    s_session->maxOwned = stats.max_owned;
+    MaliRequire(stats.max_owned == (stats.presented > 1 ? 2u : stats.presented), "peak Android output ownership accounting");
+    MaliRequire(stats.fds_created == stats.fds_closed, "exported sync FD accounting");
+    for (unsigned i = 2; i < 20; ++i) MaliRequire(stats.counts[i] == 0, "native diagnostic child count did not return to baseline");
+    MaliRequire(stats.counts[0] == 1 && stats.counts[1] == 1, "native device/queue accounting");
+    std::printf("session child counts returned to baseline; device=1 queue=1 pending=0 AHB=0 sync=0 FDs=0 exports=%u closes=%u (device/queue destroyed next)\n", stats.fds_created, stats.fds_closed);
+}
+}
+bool mali_session_active() { return s_session != nullptr; }
+bool mali_session_verbose() { return !s_session || s_session->frame <= 3; }
+int mali_session_present(const FrameInfo_t *frame) {
+    auto &s = *s_session;
+    MaliRequire(!s.stopAttempted, "frame submitted after output stop");
+    const int index = s.ownership.acquire(s.frame - 1);
+    MaliRequire(index >= 0, "output pool exhausted without an Android release");
+    auto slot = &s.slots[index];
+    slot->lastFrame = s.frame;
+    const bool verify = s.frame == 1 || s.frame == 30 || s.frame == 60 || s.frame == s.limit;
+    auto producer = MaliInterop(DD_FENCE_CREATE);
+    g_device.m_maliProducerFence = producer.fence;
+    g_device.m_maliReadbackBuffer = verify ? s.readback : VK_NULL_HANDLE;
+    FrameInfo_t mutableFrame = *frame;
+    auto sequence = vulkan_composite(&mutableFrame, nullptr, false, slot->texture.get(), false, nullptr);
+    MaliRequire(sequence.has_value(), "persistent Gamescope vulkan_composite");
+    g_device.wait(*sequence, false);
+    g_device.m_maliProducerFence = VK_NULL_HANDLE; g_device.m_maliReadbackBuffer = VK_NULL_HANDLE;
+    MaliRequire(*sequence > s.last && g_device.completedSeqNo() >= *sequence, "monotonic native KHR timeline");
+    s.last = *sequence; ++s.rendered;
+    dd_interop_input input{}; input.fence = producer.fence;
+    auto sync = MaliInterop(DD_SYNC_EXPORT, input); input = {}; input.sync = sync.sync;
+    MaliInterop(DD_SYNC_WAIT, input);
+    if (verify) MaliVerify();
+    MaliRequire(s.ownership.ready(index), "output Rendering -> Ready transition");
+    input.token = slot->ahb.token;
+    auto result = MaliTransport(DD_SESSION_PRESENT, input);
+    MaliReleased(result.token); MaliRequire(s.ownership.presented(index), "output Ready -> Android transition"); ++s.presented;
+    g_device.wait(*sequence, true); // retire only after native handoff validated identity
+    input = {}; input.sync = sync.sync; MaliInterop(DD_SYNC_CLOSE, input);
+    auto destroyFence = (PFN_vkDestroyFence)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDestroyFence");
+    destroyFence(g_device.device(), producer.fence, nullptr);
+    if (s.frame <= 3 || s.frame % 30 == 0 || s.frame == s.limit)
+        std::printf("frame=%u timeline render value=%llu output buffer token=%u producer fence exported; Android acquired; Android released token=%u\n", s.frame, (unsigned long long)*sequence, slot->ahb.token, result.token);
+    return 0;
+}
+int vulkan_mali_session_test(bool wayland) {
+    std::setvbuf(stdout, nullptr, _IOLBF, 0);
+    MaliSession session{}; session.wayland = wayland; session.limit = wayland ? 150 : 300;
+    // Bounded override for automated transport tests, never set by the Android UI.
+    if (const char *value = getenv("MALI_SESSION_FRAMES")) {
+        char *end = nullptr; unsigned long count = std::strtoul(value, &end, 10);
+        if (!*value || *end || count < 3 || count > 3000) { std::fprintf(stderr, "invalid MALI_SESSION_FRAMES\n"); return 1; }
+        session.limit = count;
+    }
+    setenv("MALI_VULKAN_SESSION_TEST", "1", 1);
+    std::puts(wayland ? "Gamescope persistent Wayland client diagnostic" : "Gamescope persistent backend diagnostic");
+    if (!MaliInitializeRenderer(true)) return 1;
+    s_session = &session; s_sessionStop = 0;
+    auto previousTerm = std::signal(SIGTERM, MaliStop), previousInt = std::signal(SIGINT, MaliStop);
+    s_maliSessionFailureCleanup = [] {
+        s_maliSessionFailureCleanup = nullptr;
+        mali_wayland_stop(false); gamescope::IBackend::Set(nullptr);
+        (void)MaliStopOutput();
+        if (s_session->releaseTimeouts) {
+            // The broker performs safe child cleanup and quarantines the exact
+            // unreleased allocation/parents. No local texture destructors or
+            // false device-destroy acknowledgement may authorize reuse.
+            auto destroy = (PFN_vkDestroyDevice)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDestroyDevice");
+            if (destroy) destroy(g_device.device(), nullptr);
+            auto destroyInstance = (PFN_vkDestroyInstance)g_pfn_vkGetInstanceProcAddr(g_device.instance(), "vkDestroyInstance");
+            if (destroyInstance) destroyInstance(g_device.instance(), nullptr);
+            std::fprintf(stderr, "persistent Gamescope session FAILED: Android release wait VkResult=%d release timeouts=%u; safe cleanup requested; Android-owned buffers retained; no PASS; exit=1\n", int(VK_TIMEOUT), s_session->releaseTimeouts);
+            std::fflush(nullptr); _Exit(1);
+        }
+    };
+    session.interop = (PFN_vkDroidDeckInteropTEST)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDroidDeckInteropTEST");
+    session.transport = (PFN_vkDroidDeckSessionTEST)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDroidDeckSessionTEST");
+    MaliRequire(session.interop && session.transport, "session transport lookup");
+    MaliRequire(gamescope::IBackend::Set<gamescope::CHeadlessBackend>(), "existing Gamescope headless backend Init");
+    MaliRequire(GetBackend()->PostInit(), "headless backend PostInit");
+    std::puts("backend=existing Gamescope HeadlessBackend; connector Present -> real vulkan_composite -> BLIT -> AHB pool");
+    MaliTransport(DD_SESSION_BEGIN);
+    session.consumerBegun = true;
+    for (auto &slot : session.slots) {
+        dd_interop_input input{}; input.width = input.height = 256;
+        slot.ahb = MaliInterop(DD_AHB_CREATE, input); slot.texture = new CVulkanTexture();
+        MaliRequire(slot.texture->BInitMaliAHB(slot.ahb.image, 256, 256), "AHB output pool view");
+    }
+    VkBufferCreateInfo ci{ .sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = 256u * 256u * 4u, .usage = VK_BUFFER_USAGE_TRANSFER_DST_BIT };
+    MaliRequire(MaliResult(g_device.vk.CreateBuffer(g_device.device(), &ci, nullptr, &session.readback), "selected readback buffer"), "selected readback buffer");
+    VkMemoryRequirements requirements{}; g_device.vk.GetBufferMemoryRequirements(g_device.device(), session.readback, &requirements);
+    uint32_t type = g_device.findMemoryType(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, requirements.memoryTypeBits);
+    session.coherent = type != ~0u;
+    if (!session.coherent) type = g_device.findMemoryType(VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT, requirements.memoryTypeBits);
+    MaliRequire(type != ~0u, "selected readback memory type");
+    VkMemoryAllocateInfo ai{ .sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = requirements.size, .memoryTypeIndex = type };
+    MaliRequire(MaliResult(g_device.vk.AllocateMemory(g_device.device(), &ai, nullptr, &session.memory), "selected readback allocation"), "selected readback allocation");
+    MaliRequire(MaliResult(g_device.vk.BindBufferMemory(g_device.device(), session.readback, session.memory, 0), "selected readback binding"), "selected readback binding");
+    currentOutputWidth = currentOutputHeight = 256;
+    gamescope::OwningRc<CVulkanTexture> source;
+    if (wayland) MaliRequire(mali_wayland_start(session.limit), "real Gamescope Wayland server/client startup");
+    else {
+        std::vector<uint8_t> bits(256u * 256u * 4u);
+        for (unsigned y = 0; y < 256; ++y) for (unsigned x = 0; x < 256; ++x) {
+            auto pixel = bits.data() + (y * 256 + x) * 4; pixel[3] = 255;
+            if (y < 128) pixel[x < 128 ? 0 : 1] = 255;
+            else if (x < 128) pixel[2] = 255; else pixel[0] = pixel[1] = pixel[2] = 255;
+        }
+        source = vulkan_create_texture_from_bits(256, 256, 256, 256, DRM_FORMAT_ABGR8888, {}, bits.data());
+        MaliRequire(source != nullptr, "persistent Gamescope input upload");
+    }
+    session.start = session.last = g_device.completedSeqNo();
+    auto begin = std::chrono::steady_clock::now(), deadline = begin;
+    for (session.frame = 1; session.frame <= session.limit && !s_sessionStop; ++session.frame) {
+        if (wayland) { source = mali_wayland_next(); MaliRequire(source != nullptr, "Wayland surface commit/texture import"); }
+        FrameInfo_t frame{}; frame.applyOutputColorMgmt = false; frame.outputEncodingEOTF = EOTF_Gamma22;
+        auto layer = frame.layers.push(); layer->tex = source.get();
+        layer->scale = wayland ? vec2_t{1, 1} : vec2_t{2, 2};
+        layer->offset = wayland ? vec2_t{0, 0} : vec2_t{-float(16 + (session.frame * 3) % 97), -64};
+        layer->opacity = 1; layer->filter = GamescopeUpscaleFilter::NEAREST; layer->blackBorder = true;
+        layer->colorspace = GAMESCOPE_APP_TEXTURE_COLORSPACE_PASSTHRU; layer->applyColorMgmt = false;
+        MaliRequire(GetBackend()->GetCurrentConnector()->Present(&frame, false) == 0, "headless connector Present");
+        layer->tex = nullptr; frame.layers.truncate(0);
+        if (wayland) source = nullptr;
+        deadline += std::chrono::microseconds(33333);
+        auto now = std::chrono::steady_clock::now();
+        if (now > deadline) { ++session.late; deadline = now; }
+        else std::this_thread::sleep_until(deadline);
+        if (wayland) mali_wayland_frame_done();
+    }
+    const bool stopped = s_sessionStop;
+    MaliRequire(mali_wayland_stop(!stopped), "Wayland client disconnect/callback/buffer-release cleanup");
+    MaliRequire(MaliResult(MaliStopOutput(), "Android release wait at session stop"), "Android release wait at session stop");
+    MaliRequire(session.releaseTimeouts == 0, "Android release timeouts must be zero for PASS");
+    source = nullptr;
+    for (auto &slot : session.slots) {
+        MaliRequire(session.ownership.free(&slot - session.slots), "Android still owns output at teardown"); slot.texture = nullptr;
+        g_device.vk.DestroyImage(g_device.device(), slot.ahb.image, nullptr); g_device.vk.FreeMemory(g_device.device(), slot.ahb.memory, nullptr);
+        dd_interop_input input{}; input.token = slot.ahb.token; MaliInterop(DD_AHB_RELEASE, input);
+    }
+    g_device.vk.DestroyBuffer(g_device.device(), session.readback, nullptr); g_device.vk.FreeMemory(g_device.device(), session.memory, nullptr);
+    gamescope::IBackend::Set(nullptr);
+    s_maliSessionCheckCleanup = MaliCheckCleanup;
+    s_maliSessionCheckDestroyed = [] {
+        // The proxy retains a failed destroy acknowledgement for this opt-in
+        // session. Enumerating the still-live instance reports that exact error.
+        uint32_t count = 0;
+        MaliRequire(MaliResult(g_device.vk.EnumeratePhysicalDevices(g_device.instance(), &count, nullptr), "native device destroy acknowledgement"), "native device destroy acknowledgement");
+        MaliRequire(count != 0, "physical inventory after diagnostic device destruction");
+        std::puts("native device/implicit queue destruction acknowledged; diagnostic counts returned to zero baseline");
+    };
