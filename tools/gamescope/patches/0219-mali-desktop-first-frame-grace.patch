diff --git a/src/mali_normal_watchdog.hpp b/src/mali_normal_watchdog.hpp
new file mode 100644
--- /dev/null
+++ b/src/mali_normal_watchdog.hpp
@@ -0,0 +1,24 @@
+#pragma once
+#include <chrono>
+#include <cstring>
+
+inline bool mali_normal_desktop_child(const char *enabled, const char *program, const char *mode) {
+    if (!enabled || std::strcmp(enabled, "1") || !program || !mode) return false;
+    const char *base = std::strrchr(program, '/');
+    return !std::strcmp(base ? base + 1 : program, "droiddeck-session") && !std::strcmp(mode, "lxqt");
+}
+
+class MaliNormalWatchdog {
+    using Clock = std::chrono::steady_clock;
+    Clock::time_point progress;
+    bool desktop;
+    bool firstFrame = false;
+public:
+    MaliNormalWatchdog(Clock::time_point start, bool desktopChild) : progress(start), desktop(desktopChild) {}
+    bool awaiting_desktop_frame() const { return desktop && !firstFrame; }
+    unsigned timeout_seconds() const { return awaiting_desktop_frame() ? 90 : 15; }
+    void presented(Clock::time_point now) { progress = now; firstFrame = true; }
+    bool expired(Clock::time_point now) const {
+        return now - progress > std::chrono::seconds(timeout_seconds());
+    }
+};
