@@ -0,0 +1,149 @@
+/* Ordinary Wayland SHM application, launched via Gamescope's session argv. */
+#include "mali_normal.hpp"
+#include <wayland-client.h>
+#include <linux/input-event-codes.h>
+#include <sys/mman.h>
+#include <unistd.h>
+#include <poll.h>
+#include <algorithm>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstring>
+#include <cerrno>
+namespace {
+static volatile sig_atomic_t quit;
+static void Stop(int) { quit = 1; }
+constexpr unsigned W = 320, H = 180, SIDE = 24;
+struct Client {
+    wl_display *display = nullptr; wl_compositor *compositor = nullptr; wl_shm *shm = nullptr;
+    wl_seat *seat = nullptr; wl_pointer *pointer = nullptr; wl_keyboard *keyboard = nullptr;
+    wl_surface *surface = nullptr; wl_callback *callback = nullptr;
+    struct Buffer { wl_buffer *buffer = nullptr; bool busy = false; Client *owner = nullptr; } buffers[2];
+    bool ready = true, failed = false; unsigned commits = 0, releases = 0, callbacks = 0;
+    unsigned motions = 0, clicks = 0, keys = 0, color = 0; int x = 148, y = 78;
+};
+static void Move(Client *c, int x, int y) { c->x = std::clamp(x, 0, int(W - SIDE)); c->y = std::clamp(y, 0, int(H - SIDE)); }
+static void Motion(void *data, wl_pointer *, uint32_t, wl_fixed_t x, wl_fixed_t y) {
+    auto c = static_cast<Client *>(data); Move(c, wl_fixed_to_int(x) - SIDE / 2, wl_fixed_to_int(y) - SIDE / 2); ++c->motions;
+}
+static const wl_pointer_listener pointerListener = {
+    .enter = [](void *data, wl_pointer *p, uint32_t, wl_surface *, wl_fixed_t x, wl_fixed_t y) { Motion(data, p, 0, x, y); },
+    .leave = [](void *, wl_pointer *, uint32_t, wl_surface *) {},
+    .motion = Motion,
+    .button = [](void *data, wl_pointer *, uint32_t, uint32_t, uint32_t, uint32_t state) {
+        auto c = static_cast<Client *>(data); if (state) { ++c->clicks; c->color = (c->color + 1) % 4; }
+    },
+    .axis = [](void *, wl_pointer *, uint32_t, uint32_t, wl_fixed_t) {},
+    .frame = [](void *, wl_pointer *) {},
+    .axis_source = [](void *, wl_pointer *, uint32_t) {},
+    .axis_stop = [](void *, wl_pointer *, uint32_t, uint32_t) {},
+    .axis_discrete = [](void *, wl_pointer *, uint32_t, int32_t) {},
+};
+static const wl_keyboard_listener keyboardListener = {
+    .keymap = [](void *, wl_keyboard *, uint32_t, int32_t fd, uint32_t) { close(fd); },
+    .enter = [](void *, wl_keyboard *, uint32_t, wl_surface *, wl_array *) {},
+    .leave = [](void *, wl_keyboard *, uint32_t, wl_surface *) {},
+    .key = [](void *data, wl_keyboard *, uint32_t, uint32_t, uint32_t key, uint32_t state) {
+        if (!state) return;
+        auto c = static_cast<Client *>(data); ++c->keys;
+        if (key == KEY_ESC) { quit = 1; return; }
+        if (key == KEY_LEFT || key == KEY_A) Move(c, c->x - 8, c->y);
+        if (key == KEY_RIGHT || key == KEY_D) Move(c, c->x + 8, c->y);
+        if (key == KEY_UP || key == KEY_W) Move(c, c->x, c->y - 8);
+        if (key == KEY_DOWN || key == KEY_S) Move(c, c->x, c->y + 8);
+        if (key == KEY_SPACE || key == KEY_ENTER) c->color = (c->color + 1) % 4;
+    },
+    .modifiers = [](void *, wl_keyboard *, uint32_t, uint32_t, uint32_t, uint32_t, uint32_t) {},
+    .repeat_info = [](void *, wl_keyboard *, int32_t, int32_t) {},
+};
+static const wl_seat_listener seatListener = {
+    .capabilities = [](void *data, wl_seat *seat, uint32_t caps) {
+        auto c = static_cast<Client *>(data);
+        if ((caps & WL_SEAT_CAPABILITY_POINTER) && !c->pointer) { c->pointer = wl_seat_get_pointer(seat); wl_pointer_add_listener(c->pointer, &pointerListener, c); }
+        if ((caps & WL_SEAT_CAPABILITY_KEYBOARD) && !c->keyboard) { c->keyboard = wl_seat_get_keyboard(seat); wl_keyboard_add_listener(c->keyboard, &keyboardListener, c); }
+    },
+    .name = [](void *, wl_seat *, const char *) {},
+};
+static const wl_registry_listener registryListener = {
+    .global = [](void *data, wl_registry *registry, uint32_t name, const char *interface, uint32_t version) {
+        auto c = static_cast<Client *>(data);
+        if (!strcmp(interface, "wl_compositor")) c->compositor = static_cast<wl_compositor *>(wl_registry_bind(registry, name, &wl_compositor_interface, std::min(version, 4u)));
+        if (!strcmp(interface, "wl_shm")) c->shm = static_cast<wl_shm *>(wl_registry_bind(registry, name, &wl_shm_interface, 1));
+        if (!strcmp(interface, "wl_seat")) { c->seat = static_cast<wl_seat *>(wl_registry_bind(registry, name, &wl_seat_interface, std::min(version, 5u))); wl_seat_add_listener(c->seat, &seatListener, c); }
+    },
+    .global_remove = [](void *, wl_registry *, uint32_t) {},
+};
+static const wl_buffer_listener releaseListener{
+    [](void *data, wl_buffer *) { auto b = static_cast<Client::Buffer *>(data); if (!b->busy) b->owner->failed = true; b->busy = false; ++b->owner->releases; }
+};
+static const wl_callback_listener callbackListener{
+    [](void *data, wl_callback *callback, uint32_t) { auto c = static_cast<Client *>(data); wl_callback_destroy(callback); c->callback = nullptr; c->ready = true; ++c->callbacks; }
+};
+static bool Dispatch(Client &c, int timeout) {
+    while (wl_display_prepare_read(c.display)) if (wl_display_dispatch_pending(c.display) < 0) return false;
+    if (wl_display_flush(c.display) < 0 && errno != EAGAIN) { wl_display_cancel_read(c.display); return false; }
