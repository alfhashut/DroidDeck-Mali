+/* Normal session only. Fixed-size counters; formatting/sorting once per 2 s. */
+#include <algorithm>
+#include "renderer_protocol.h"
+#include "interop_protocol.h"
+#include "normal_opcode_perf.h"
+namespace {
+struct NormalPerformance {
+    dd_perf_rpc rpc{}, outside{};
+    uint64_t begin = 0, cpuBegin = 0, cpuNs = 0, lastEnd = 0, report = 0, tick = 0;
+    uint64_t frameNs = 0, cadenceNs = 0, uploadNs = 0, compositeNs = 0, acquireNs = 0, commitNs = 0;
+    uint64_t currentUpload = 0, currentComposite = 0, currentAcquire = 0, currentCommit = 0;
+    uint64_t outputWaitNs = 0, occupiedNs = 0, androidNs = 0, ackNs = 0, ackCount = 0;
+    uint64_t samples[DD_PERF_SAMPLES]{}, cadence[DD_PERF_SAMPLES]{};
+    uint64_t lastFrameNs = 0, lastRpcNs = 0, lastRpcCount = 0, lastWorst = 0;
+    unsigned lastWorstOp = 0, frames = 0, attempts = 0, missed = 0, maxAndroid = 0, previousPresented = 0;
+    bool waitingOutput = false;
+} normalPerf;
+}
+
+void vulkan_mali_normal_frame_begin() {
+    dd_perf_rpc ignored{};
+    MaliRequire(MaliResult(normalOutput.performance(g_device.device(), &ignored, VK_TRUE), "normal local performance reset"), "normal local performance reset");
+    auto &p = normalPerf;
+    dd_perf_merge(&p.outside, &ignored); // Preserve RPCs between frame attempts.
+    p.begin = dd_perf_now(); p.cpuBegin = dd_perf_cpu_now(); p.currentUpload = p.currentComposite = p.currentAcquire = p.currentCommit = 0;
+}
+void vulkan_mali_normal_upload_done() { normalPerf.currentUpload = dd_perf_now() - normalPerf.begin; }
+void vulkan_mali_normal_frame_end(bool presented) {
+    auto &p = normalPerf; dd_perf_rpc rpc{};
+    MaliRequire(MaliResult(normalOutput.performance(g_device.device(), &rpc, VK_TRUE), "normal local performance snapshot"), "normal local performance snapshot");
+    dd_perf_merge(&p.rpc, &rpc); ++p.attempts;
+    uint64_t now = dd_perf_now(), work = now - p.begin;
+    p.cpuNs += dd_perf_cpu_now() - p.cpuBegin;
+    if (p.attempts <= DD_PERF_SAMPLES) p.samples[p.attempts - 1] = work;
+    p.frameNs += work; p.uploadNs += p.currentUpload; p.compositeNs += p.currentComposite;
+    p.acquireNs += p.currentAcquire; p.commitNs += p.currentCommit;
+    if (presented) {
+        uint64_t cadence = p.lastEnd ? now - p.lastEnd : work;
+        if (p.frames < DD_PERF_SAMPLES) p.cadence[p.frames] = cadence;
+        ++p.frames; p.cadenceNs += cadence; p.lastEnd = now;
+        /* Work over budget, or a missed completion-to-completion deadline.
+         * A 1 ms tolerance avoids counting clock/scheduler jitter at 30 Hz. */
+        if (work > DD_PERF_TARGET_NS || cadence > DD_PERF_TARGET_NS + 1000000u) { ++p.missed; ++normalOutput.late; }
+    }
+    p.lastFrameNs = work; p.lastRpcNs = p.lastRpcCount = p.lastWorst = 0; p.lastWorstOp = 0;
+    for (unsigned i = 0; i < DD_PERF_OPS; ++i) {
+        auto &op = rpc.op[i]; p.lastRpcNs += op.ns; p.lastRpcCount += op.count;
+        if (op.worst > p.lastWorst) { p.lastWorst = op.worst; p.lastWorstOp = i; }
+    }
+}
+bool vulkan_mali_normal_available() {
+    for (unsigned i = 0; i < 3; ++i) if (normalOutput.ownership.free(i)) { normalPerf.waitingOutput = false; return true; }
+    normalPerf.waitingOutput = true;
+    return false; // Only observes ownership; never acquires, recycles or assumes release.
+}
+void vulkan_mali_normal_tick() {
+    auto &p = normalPerf; auto &s = normalOutput;
+    uint64_t now = dd_perf_now(); unsigned occupied = 0, android = 0;
+    for (unsigned i = 0; i < 3; ++i) { occupied += !s.ownership.free(i); android += s.ownership.androidOwned(i); }
+    uint64_t elapsed = p.tick ? now - p.tick : 0; p.tick = now;
+    // Occupancy samples are time weighted at event-loop ticks, not GPU telemetry.
+    p.occupiedNs += elapsed * occupied; p.androidNs += elapsed * android;
+    if (p.waitingOutput) p.outputWaitNs += elapsed;
+    p.maxAndroid = std::max(p.maxAndroid, android);
+    if (!p.report) {
+        // Discard initialization RPCs before the first normal-loop window.
+        dd_perf_rpc startup{};
+        MaliRequire(MaliResult(s.performance(g_device.device(), &startup, VK_TRUE), "normal initial performance reset"), "normal initial performance reset");
+        p.report = now; return;
+    }
+    if (now - p.report < DD_PERF_INTERVAL_NS) return;
+    dd_normal_output stats{};
+    MaliRequire(MaliResult(NormalRPC(MB_NORMAL_STATS, {}, &stats), "normal periodic accounting"), "normal periodic accounting");
+    dd_perf_rpc outside{};
+    MaliRequire(MaliResult(s.performance(g_device.device(), &outside, VK_TRUE), "normal outside-frame performance snapshot"), "normal outside-frame performance snapshot");
+    dd_perf_merge(&p.outside, &outside); // Includes this window's STATS round trip.
+    uint64_t count = 0, rpcNs = 0, worst = 0; unsigned worstOp = 0, top[3]{};
+    for (unsigned i = 0; i < DD_PERF_OPS; ++i) {
+        auto &op = p.rpc.op[i]; count += op.count; rpcNs += op.ns;
+        if (op.worst > worst) { worst = op.worst; worstOp = i; }
+        for (unsigned j = 0; j < 3; ++j) if (op.ns > p.rpc.op[top[j]].ns) {
+            for (unsigned k = 2; k > j; --k) top[k] = top[k - 1];
+            top[j] = i; break;
+        }
+    }
+    double window = double(now - p.report), frames = p.frames ? p.frames : 1;
+    double attempts = p.attempts ? p.attempts : 1;
+    uint64_t syncWait = p.rpc.op[MB_RENDERER_WAIT].ns + p.rpc.op[MB_SYNC_WAIT].ns;
+    uint64_t nonRpc = p.frameNs > rpcNs ? p.frameNs - rpcNs : 0;
+    uint64_t outsideFrames = uint64_t(window) > p.frameNs ? uint64_t(window) - p.frameNs : 0;
+    std::printf("MaliPerf frame: committed-FPS=%.2f Android-FPS=%.2f frames=%u attempts=%u work-avg/p95=%.3f/%.3fms cadence-avg/p95=%.3f/%.3fms missed=%u last-work=%.3fms last-RPCs=%llu last-RPC=%.3fms last-worst=%.3fms opcode=%u\n",
+        p.frames * 1e9 / window, (stats.presented - p.previousPresented) * 1e9 / window, p.frames, p.attempts,
+        p.frameNs / attempts / 1e6, dd_perf_p95(p.samples, p.attempts) / 1e6, p.cadenceNs / frames / 1e6,
+        dd_perf_p95(p.cadence, p.frames) / 1e6, p.missed, p.lastFrameNs / 1e6,
+        (unsigned long long)p.lastRpcCount, p.lastRpcNs / 1e6, p.lastWorst / 1e6, p.lastWorstOp);
+    std::printf("MaliPerf stages ms/attempt: SHM-import-upload=%.3f compositor-CPU=%.3f pool-acquire=%.3f queue-submit-RPC=%.3f timeline-RPC=%.3f SYNC_FD-export-RPC=%.3f sync-wait-RPC=%.3f publish-RPC=%.3f Wayland-commit-CPU=%.3f release-ack-lifetime=%.3fms/%llu (CPU stages include nested RPCs; no GPU timestamps)\n",
+        p.uploadNs / attempts / 1e6, p.compositeNs / attempts / 1e6, p.acquireNs / attempts / 1e6,
+        p.rpc.op[MB_RENDERER_SUBMIT].ns / attempts / 1e6, p.rpc.op[MB_RENDERER_WAIT].ns / attempts / 1e6,
+        p.rpc.op[MB_SYNC_EXPORT].ns / attempts / 1e6, p.rpc.op[MB_SYNC_WAIT].ns / attempts / 1e6,
+        p.rpc.op[MB_NORMAL_PUBLISH].ns / attempts / 1e6, p.commitNs / attempts / 1e6,
+        p.ackCount ? p.ackNs / double(p.ackCount) / 1e6 : 0, (unsigned long long)p.ackCount);
+    std::printf("MaliPerf RPC: per-frame=%.2f total=%llu total=%.3fms latency-avg=%.3fms worst=%.3fms opcode=%u uploads/frame=%.0fbytes write-RPCs/frame=%.2f copies/frame=%.2f compute-blits/frame=%.2f read-RPCs=%llu AHB-creates=%llu idle-RPCs=%llu fence-creates=%llu image-creates=%llu allocations=%llu\n",
+        count / frames, (unsigned long long)count, rpcNs / 1e6, count ? rpcNs / double(count) / 1e6 : 0,
+        worst / 1e6, worstOp, p.rpc.upload_bytes / frames, p.rpc.op[MB_MEMORY_WRITE].count / frames,
+        (p.rpc.op[MB_RENDERER_COPY].count + p.rpc.op[MB_COMMAND_COPY].count) / frames,
+        p.rpc.op[MB_RENDERER_DISPATCH].count / frames, (unsigned long long)p.rpc.op[MB_MEMORY_READ].count,
