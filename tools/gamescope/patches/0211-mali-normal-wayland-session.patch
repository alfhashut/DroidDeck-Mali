+++ b/src/mali_normal.cpp
@@ -0,0 +1,269 @@
+/* Experimental normal single-client session. Output is the actual CWaylandBackend,
+ * input uses its existing seat listeners, SHM imports use Gamescope's renderer.
+ * The application is an argv child, with no diagnostic frame limit/injection. */
+#include "mali_normal.hpp"
+#include "backend.h"
+#include "backends.h"
+#include "rendervulkan.hpp"
+#include "wlr_begin.hpp"
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/interfaces/wlr_keyboard.h>
+#include "wlr_end.hpp"
+#include <wayland-client.h>
+#include <banner-ahb-v1-client-protocol.h>
+#include <xkbcommon/xkbcommon.h>
+#include <linux/input-event-codes.h>
+#include <sys/wait.h>
+#include <poll.h>
+#include <unistd.h>
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <csignal>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <deque>
+#include <mutex>
+#include <string>
+#include <thread>
+
+extern int g_nPreferredOutputWidth, g_nPreferredOutputHeight, g_nNestedWidth, g_nNestedHeight;
+extern int g_nNestedRefresh, g_nOutputRefresh;
+extern bool g_bFullscreen, g_bBorderlessOutputWindow;
+namespace {
+static std::atomic<bool> failed;
+static volatile sig_atomic_t stopped;
+static void Stop(int) { stopped = 1; }
+struct Input { unsigned type; double x, y; uint32_t code, state; };
+static std::mutex inputLock;
+static std::deque<Input> inputs;
+struct Host {
+    wl_display *display = nullptr; wl_surface *surface = nullptr; banner_ahb_v1 *manager = nullptr;
+    struct Buffer { wl_buffer *buffer = nullptr; unsigned index = 0; bool busy = false; } buffers[3];
+} host;
+struct Server {
+    wl_display *display = nullptr; wlr_renderer *renderer = nullptr; wlr_surface *surface = nullptr;
+    wlr_seat *seat = nullptr; wlr_keyboard *keyboard = nullptr;
+    wl_listener created{}, committed{}, destroyed{};
+    pid_t child = -1; bool pending = false;
+    unsigned commits = 0, frames = 0, motions = 0, buttons = 0, keys = 0;
+} server;
+static void Released(void *data, wl_buffer *) {
+    auto b = static_cast<Host::Buffer *>(data);
+    if (!b->busy) { mali_normal_failure("duplicate output wl_buffer.release"); return; }
+    b->busy = false; mali_normal_released(b->index);
+}
+static const wl_buffer_listener releaseListener{Released};
+static bool Roundtrip() {
+    if (!host.display) return false;
+    bool done = false; wl_callback *callback = wl_display_sync(host.display);
+    if (!callback) return false;
+    static const wl_callback_listener listener{ [](void *data, wl_callback *, uint32_t) { *static_cast<bool *>(data) = true; } };
+    wl_callback_add_listener(callback, &listener, &done);
+    auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(5);
+    while (!done && !failed && std::chrono::steady_clock::now() < deadline) {
+        gamescope::IBackend::Get()->PollState();
+        if (wl_display_get_error(host.display)) break;
+        std::this_thread::sleep_for(std::chrono::milliseconds(1));
+    }
+    wl_callback_destroy(callback); return done;
+}
+static void Commit(wl_listener *, void *) {
+    if (server.surface && wlr_surface_has_buffer(server.surface)) { server.pending = true; ++server.commits; }
+}
+static void Destroy(wl_listener *, void *) {
+    wl_list_remove(&server.committed.link); wl_list_remove(&server.destroyed.link);
+    server.surface = nullptr; server.pending = false;
+}
+static void NewSurface(wl_listener *, void *data) {
+    if (server.surface) { mali_normal_failure("Checkpoint 7 accepts one interactive surface"); return; }
+    server.surface = static_cast<wlr_surface *>(data);
+    server.committed.notify = Commit; server.destroyed.notify = Destroy;
+    wl_signal_add(&server.surface->events.commit, &server.committed);
+    wl_signal_add(&server.surface->events.destroy, &server.destroyed);
+    wlr_seat_keyboard_notify_enter(server.seat, server.surface, nullptr, 0, &server.keyboard->modifiers);
+}
+static bool Dispatch(int timeout) {
+    if (wl_event_loop_dispatch(wl_display_get_event_loop(server.display), timeout) < 0) return false;
+    std::deque<Input> queue;
+    { std::lock_guard lock(inputLock); queue.swap(inputs); }
+    if (server.surface && server.surface->current.width > 0 && server.surface->current.height > 0) {
+        uint32_t time = uint32_t(std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now().time_since_epoch()).count());
+        for (auto &event : queue) {
+            if (event.type == 1) {
+                double x = std::clamp(event.x / g_nPreferredOutputWidth, 0.0, 1.0) * server.surface->current.width;
+                double y = std::clamp(event.y / g_nPreferredOutputHeight, 0.0, 1.0) * server.surface->current.height;
+                wlr_seat_pointer_notify_enter(server.seat, server.surface, x, y);
+                wlr_seat_pointer_notify_motion(server.seat, time, x, y); ++server.motions;
+            } else if (event.type == 2) {
+                wlr_seat_pointer_notify_button(server.seat, time, event.code, wl_pointer_button_state(event.state)); ++server.buttons;
+            } else if (event.type == 3) {
+                wlr_seat_keyboard_notify_key(server.seat, time, event.code, event.state); ++server.keys;
+            }
+        }
+        if (!queue.empty()) wlr_seat_pointer_notify_frame(server.seat);
+    }
+    wl_display_flush_clients(server.display); return !failed;
+}
+static bool StartServer(char **command) {
+    server.display = wl_display_create(); server.renderer = vulkan_renderer_create();
+    if (!server.display || !server.renderer || !wlr_renderer_init_wl_display(server.renderer, server.display)) return false;
+    auto compositor = wlr_compositor_create(server.display, 5, server.renderer);
+    server.seat = wlr_seat_create(server.display, "seat0");
+    server.keyboard = static_cast<wlr_keyboard *>(calloc(1, sizeof(wlr_keyboard)));
+    if (!compositor || !server.seat || !server.keyboard) return false;
+    wlr_keyboard_init(server.keyboard, nullptr, "DroidDeck nested keyboard");
+    auto context = xkb_context_new(XKB_CONTEXT_NO_FLAGS);
+    auto keymap = context ? xkb_keymap_new_from_names(context, nullptr, XKB_KEYMAP_COMPILE_NO_FLAGS) : nullptr;
+    bool ok = keymap && wlr_keyboard_set_keymap(server.keyboard, keymap);
+    if (keymap) xkb_keymap_unref(keymap);
+    if (context) xkb_context_unref(context);
+    if (!ok) return false;
+    wlr_keyboard_set_repeat_info(server.keyboard, 25, 600);
+    wlr_seat_set_keyboard(server.seat, server.keyboard);
+    wlr_seat_set_capabilities(server.seat, WL_SEAT_CAPABILITY_POINTER | WL_SEAT_CAPABILITY_KEYBOARD);
+    server.created.notify = NewSurface; wl_signal_add(&compositor->events.new_surface, &server.created);
+    const char *socket = wl_display_add_socket_auto(server.display);
+    if (!socket) return false;
+    std::string socketName(socket);
+    server.child = fork();
+    if (server.child < 0) return false;
+    if (!server.child) {
+        setenv("WAYLAND_DISPLAY", socketName.c_str(), 1);
+        unsetenv("VK_DRIVER_FILES"); unsetenv("VK_ICD_FILENAMES");
+        unsetenv("MALI_VULKAN_BROKER_SOCKET"); unsetenv("MALI_VULKAN_NORMAL_SESSION");
+        unsetenv("MALI_VULKAN_RENDERER_TEST"); unsetenv("MALI_VULKAN_AHB_TEST");
+        unsetenv("MALI_VULKAN_SHARED_STAGING");
+        execvp(command[0], command); std::perror("normal Wayland child exec"); _Exit(127);
+    }
+    std::printf("normal Wayland client pid=%d socket=%s; outer WAYLAND_DISPLAY=wayland-0; existing nested pointer/touch/keyboard seat\n", int(server.child), socketName.c_str());
+    return true;
+}
+static void StopServer() {
+    if (server.child > 0) {
+        kill(server.child, SIGTERM);
+        auto end = std::chrono::steady_clock::now() + std::chrono::milliseconds(500); int status = 0;
+        while (std::chrono::steady_clock::now() < end) {
+            pid_t r = waitpid(server.child, &status, WNOHANG);
+            if (r == server.child || (r < 0 && errno == ECHILD)) { server.child = -1; break; }
+            if (server.display) Dispatch(5);
+        }
+        if (server.child > 0) { kill(server.child, SIGKILL); while (waitpid(server.child, &status, 0) < 0 && errno == EINTR) {} }
+    }
+    if (server.display) {
+        wl_display_destroy_clients(server.display);
+        if (server.created.link.next) wl_list_remove(&server.created.link);
+        if (server.seat) wlr_seat_destroy(server.seat);
+        if (server.keyboard) { wlr_keyboard_finish(server.keyboard); free(server.keyboard); }
+        wl_display_destroy(server.display);
+    }
+    if (server.renderer) wlr_renderer_destroy(server.renderer);
+    std::printf("normal input summary: motion=%u button=%u keyboard=%u commits=%u frames=%u\n", server.motions, server.buttons, server.keys, server.commits, server.frames);
+    server = {};
+}
+}
+void mali_normal_failure(const char *reason) { if (!failed.exchange(true)) std::fprintf(stderr, "normal Mali session FAILED: %s\n", reason); }
+void mali_normal_input(unsigned type, double x, double y, uint32_t code, uint32_t state) {
+    std::lock_guard lock(inputLock);
+    if (type == 1 && !inputs.empty() && inputs.back().type == 1) { inputs.back() = {type, x, y, code, state}; return; }
+    if (inputs.size() >= 512) { mali_normal_failure("input queue overflow"); return; }
+    inputs.push_back({type, x, y, code, state});
+}
+bool mali_normal_bind(wl_display *display, wl_surface *surface, banner_ahb_v1 *manager) {
+    if (!display || !surface || !manager) return false;
+    host.display = display; host.surface = surface; host.manager = manager;
+    return true;
+}
+bool mali_normal_buffer(unsigned index, uint32_t key, unsigned width, unsigned height) {
+    if (!host.manager || index >= 3) return false;
+    auto &b = host.buffers[index]; b.index = index;
+    b.buffer = banner_ahb_v1_create_broker_buffer(host.manager, key, width, height);
+    if (!b.buffer) return false;
+    wl_buffer_add_listener(b.buffer, &releaseListener, &b);
+    return Roundtrip(); // proves the Android-local AHB was acquired before publish
+}
+void mali_normal_commit(unsigned index) {
+    auto &b = host.buffers[index];
+    if (b.busy || !b.buffer || !host.surface) { mali_normal_failure("normal output wl_buffer reused while busy"); return; }
+    b.busy = true; wl_surface_attach(host.surface, b.buffer, 0, 0);
+    wl_surface_damage_buffer(host.surface, 0, 0, INT32_MAX, INT32_MAX); wl_surface_commit(host.surface);
+    if (wl_display_flush(host.display) < 0 && errno != EAGAIN) mali_normal_failure("outer Wayland commit failed");
+}
+void mali_normal_stop_client() { StopServer(); }
+void mali_normal_detach_output() {
+    if (host.surface) { wl_surface_attach(host.surface, nullptr, 0, 0); wl_surface_commit(host.surface); wl_display_flush(host.display); }
+}
+void mali_normal_destroy_buffers() {
+    for (auto &b : host.buffers) { if (b.buffer) wl_buffer_destroy(b.buffer); b = {}; }
+    if (host.display) wl_display_flush(host.display);
+}
+int mali_normal_main(int argc, char **argv) {
+    std::setvbuf(stdout, nullptr, _IOLBF, 0);
+    const char *enabled = getenv("MALI_VULKAN_NORMAL_SESSION"), *outer = getenv("WAYLAND_DISPLAY");
+    if (!enabled || strcmp(enabled, "1") || !outer || strcmp(outer, "wayland-0")) {
+        std::fputs("normal Mali session requires its isolated environment and outer wayland-0\n", stderr); return 1;
+    }
+    unsigned width = 0, height = 0; char **command = nullptr; bool wayland = false;
+    for (int i = 1; i < argc; ++i) {
+        if (!strcmp(argv[i], "--")) { if (i + 1 < argc) command = argv + i + 1; break; }
+        if (!strcmp(argv[i], "--mali-wayland-session") || !strcmp(argv[i], "--expose-wayland") || !strcmp(argv[i], "-f")) continue;
+        if (!strcmp(argv[i], "--backend") && i + 1 < argc) { wayland = !strcmp(argv[++i], "wayland"); continue; }
+        if ((!strcmp(argv[i], "-W") || !strcmp(argv[i], "-H")) && i + 1 < argc) {
+            bool isWidth = !strcmp(argv[i], "-W"); char *end = nullptr; unsigned long value = strtoul(argv[++i], &end, 10);
+            if (!*argv[i] || *end || value < 32 || value > 4096) return 1;
+            (isWidth ? width : height) = value; continue;
+        }
+        std::fprintf(stderr, "unsupported normal Mali option: %s\n", argv[i]); return 1;
+    }
+    if (!width || !height || !command || !wayland) { std::fputs("normal Mali session needs --backend wayland -W width -H height -- client\n", stderr); return 1; }
+    g_maliNormalSessionActive = true; failed = false; stopped = 0;
+    std::signal(SIGTERM, Stop); std::signal(SIGINT, Stop); std::signal(SIGHUP, Stop);
+    g_nPreferredOutputWidth = g_nNestedWidth = width; g_nPreferredOutputHeight = g_nNestedHeight = height;
+    g_nNestedRefresh = g_nOutputRefresh = 30000; g_bFullscreen = true; g_bBorderlessOutputWindow = true;
+    bool renderer = vulkan_mali_normal_init(width, height);
+    bool backend = renderer && gamescope::IBackend::Set<gamescope::CWaylandBackend>();
+    auto connector = backend ? gamescope::IBackend::Get()->CreateVirtualConnector(0) : nullptr;
+    bool ok = connector && gamescope::IBackend::Get()->PostInit() && vulkan_mali_normal_outputs() && StartServer(command);
+    auto next = std::chrono::steady_clock::now(); auto progress = next;
+    int childStatus = 0;
+    while (ok && !stopped && !failed) {
+        gamescope::IBackend::Get()->PollState();
+        if (wl_display_get_error(host.display)) { mali_normal_failure("Android compositor disconnected"); break; }
+        if (!Dispatch(0)) { ok = false; break; }
+        if (server.child > 0) {
+            pid_t r = waitpid(server.child, &childStatus, WNOHANG);
+            if (r == server.child) { server.child = -1; ok = WIFEXITED(childStatus) && WEXITSTATUS(childStatus) == 0; break; }
+        }
+        auto now = std::chrono::steady_clock::now();
+        if (server.pending && server.surface && now >= next) {
+            auto texture = wlr_surface_get_texture(server.surface);
+            auto wrapped = reinterpret_cast<VulkanWlrTexture_t *>(texture);
+            auto source = wrapped && wrapped->buf ? vulkan_create_texture_from_wlr_buffer(wrapped->buf, nullptr) : nullptr;
+            if (!source) { ok = false; break; }
+            FrameInfo_t frame{}; auto &layer = *frame.layers.push();
+            layer.tex = source.get(); layer.opacity = 1.0f; layer.filter = GamescopeUpscaleFilter::NEAREST;
+            layer.scale = {source->width() / float(width), source->height() / float(height)};
+            layer.colorspace = GAMESCOPE_APP_TEXTURE_COLORSPACE_PASSTHRU; layer.blackBorder = true; layer.applyColorMgmt = false; frame.outputEncodingEOTF = EOTF_Gamma22;
+            int result = connector->Present(&frame, false);
+            if (result == 0) {
+                timespec time{}; clock_gettime(CLOCK_MONOTONIC, &time); wlr_surface_send_frame_done(server.surface, &time);
+                server.pending = false; ++server.frames; wl_display_flush_clients(server.display); progress = now;
+            } else if (result != EAGAIN) { ok = false; break; }
+            next = std::chrono::steady_clock::now() + std::chrono::nanoseconds(33333333);
+        }
+        if (now - progress > std::chrono::seconds(15)) { mali_normal_failure("normal session made no frame progress for 15 seconds"); break; }
+        std::this_thread::sleep_for(std::chrono::milliseconds(2));
+    }
+    ok &= !failed;
+    StopServer();
+    if (renderer) ok &= vulkan_mali_normal_stop() == 0;
+    connector.reset(); gamescope::IBackend::Set(nullptr);
+    if (host.manager) banner_ahb_v1_destroy(host.manager);
+    if (host.display) wl_display_disconnect(host.display);
+    host = {}; g_maliNormalSessionActive = false;
+    std::printf("normal Mali Wayland session exit=%d client status=%d\n", ok ? 0 : 1, childStatus);
+    return ok ? 0 : 1;
+}
