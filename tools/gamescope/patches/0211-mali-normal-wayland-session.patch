+struct wl_display;
+struct wl_surface;
+struct banner_ahb_v1;
+extern bool g_maliNormalSessionActive;
+inline bool mali_normal_active() { return g_maliNormalSessionActive; }
+inline bool mali_normal_verbose() { const char *v = getenv("MALI_VULKAN_VERBOSE"); return v && !strcmp(v, "1"); }
+void mali_normal_input(unsigned type, double x, double y, uint32_t code, uint32_t state);
+void mali_normal_failure(const char *reason);
+bool mali_normal_bind(wl_display *, wl_surface *, banner_ahb_v1 *);
