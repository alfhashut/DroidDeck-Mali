+void mali_normal_released(unsigned index);
+bool vulkan_mali_normal_init(unsigned width, unsigned height);
+bool vulkan_mali_normal_outputs();
+int vulkan_mali_normal_present(const FrameInfo_t *);
+int vulkan_mali_normal_stop();
+int mali_normal_main(int argc, char **argv);
+int mali_interactive_main();
diff --git a/src/mali_normal.inc b/src/mali_normal.inc
new file mode 100644
index 0000000..4df57b2
--- /dev/null
+++ b/src/mali_normal.inc
@@ -0,0 +1,136 @@
+/* Normal nested Wayland AHB output. Compiled in the real Gamescope renderer TU. */
+#include "mali_normal.hpp"
+#include "mali_output_pool.hpp"
+#include "normal_api.h"
+bool g_maliNormalSessionActive = false;
+namespace {
+struct NormalOutput {
+    struct Slot { dd_interop_output ahb{}; gamescope::OwningRc<CVulkanTexture> texture; uint32_t key = 0, frame = 0; } slots[3];
+    MaliOutputPool ownership;
+    PFN_vkDroidDeckInteropTEST interop = nullptr;
+    PFN_vkDroidDeckWaylandMALI transport = nullptr;
+    unsigned width = 0, height = 0, frame = 0, rendered = 0, presented = 0, released = 0, dropped = 0;
+    uint64_t sequence = 0;
+    bool begun = false, stopping = false;
+    unsigned timeouts = 0;
+} normalOutput;
+static dd_interop_output NormalInterop(uint32_t op, dd_interop_input input = {}) {
+    dd_interop_output out{};
+    MaliRequire(MaliResult(normalOutput.interop(g_device.device(), op, &input, &out), "normal AHB/sync RPC"), "normal AHB/sync RPC");
+    return out;
+}
+static VkResult NormalRPC(uint32_t op, dd_normal_input input = {}, dd_normal_output *out = nullptr) {
+    dd_normal_output ignored{};
+    return normalOutput.transport(g_device.device(), op, &input, out ? out : &ignored);
+}
+static void NormalBaseline() {
+    dd_normal_output stats{};
+    MaliRequire(MaliResult(NormalRPC(MB_NORMAL_STATS, {}, &stats), "normal final accounting"), "normal final accounting");
+    for (unsigned i = 2; i < 20; ++i) MaliRequire(stats.counts[i] == 0, "normal native children did not return to baseline");
+    MaliRequire(stats.counts[0] == 1 && stats.counts[1] == 1 && !stats.owned && !stats.timeouts && stats.fds_created == stats.fds_closed,
+                "normal final ownership/FD baseline");
+    normalOutput.dropped = normalOutput.presented - stats.presented;
+    std::printf("normal actual Android output: presented=%u released=%u cancelled before display=%u\n", stats.presented, stats.released, normalOutput.dropped);
+    std::printf("normal final native children: AHB=0 sync=0 FDs=0 pending=0 AndroidHeld=0 release timeouts=0 exported=%u closed=%u; device/queue destroyed next\n", stats.fds_created, stats.fds_closed);
+}
+}
+bool vulkan_mali_normal_init(unsigned width, unsigned height) {
+    normalOutput = {}; normalOutput.width = width; normalOutput.height = height;
+    if (!MaliInitializeRenderer(true)) return false;
+    normalOutput.interop = (PFN_vkDroidDeckInteropTEST)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDroidDeckInteropTEST");
+    normalOutput.transport = (PFN_vkDroidDeckWaylandMALI)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDroidDeckWaylandMALI");
+    if (!normalOutput.interop || !normalOutput.transport) { g_device.ShutdownMaliDiagnostic(); return false; }
+    dd_normal_input begin{}; begin.verbose = mali_normal_verbose();
+    if (!MaliResult(NormalRPC(MB_NORMAL_BEGIN, begin), "normal begin")) { g_device.ShutdownMaliDiagnostic(); return false; }
+    normalOutput.begun = true;
+    currentOutputWidth = width; currentOutputHeight = height;
+    s_maliSessionFailureCleanup = [] {
+        s_maliSessionFailureCleanup = nullptr;
+        normalOutput.stopping = true; mali_normal_stop_client(); mali_normal_detach_output();
+        if (normalOutput.begun && normalOutput.transport) {
+            VkResult r = NormalRPC(MB_NORMAL_END);
+            if (r == VK_TIMEOUT) { ++normalOutput.timeouts; std::fputs("normal Android release TIMEOUT: broker retains allocations; no PASS\n", stderr); }
+        }
+    };
+    return true;
+}
+bool vulkan_mali_normal_outputs() {
+    for (unsigned i = 0; i < 3; ++i) {
+        auto &slot = normalOutput.slots[i]; dd_interop_input input{};
+        input.width = normalOutput.width; input.height = normalOutput.height;
+        slot.ahb = NormalInterop(DD_AHB_CREATE, input); slot.texture = new CVulkanTexture();
+        if (!slot.texture->BInitMaliAHB(slot.ahb.image, input.width, input.height)) return false;
+        dd_normal_input registerInput{}; registerInput.token = slot.ahb.token; dd_normal_output out{};
+        if (NormalRPC(MB_NORMAL_REGISTER, registerInput, &out) != VK_SUCCESS || !out.key) return false;
+        slot.key = out.key;
+        if (!mali_normal_buffer(i, out.key, input.width, input.height)) return false;
+    }
+    std::printf("normal nested Wayland output: %ux%u pool=3 FP32 PASSTHRU real KHR timeline; routine readbacks/hashes disabled\n", normalOutput.width, normalOutput.height);
+    return true;
+}
+void mali_normal_released(unsigned index) {
+    MaliRequire(index < 3 && normalOutput.ownership.released(index), "normal unexpected/duplicate Wayland buffer release");
+    ++normalOutput.released;
+}
+int vulkan_mali_normal_present(const FrameInfo_t *frame) {
+    auto &s = normalOutput;
+    if (s.stopping) return -1;
+    int index = s.ownership.acquire(s.frame);
+    if (index < 0) { ++s.dropped; return EAGAIN; } // dispatch real releases before any reuse
+    auto &slot = s.slots[index]; slot.frame = ++s.frame;
+    auto producer = NormalInterop(DD_FENCE_CREATE); g_device.m_maliProducerFence = producer.fence;
+    g_device.m_maliReadbackBuffer = VK_NULL_HANDLE;
+    FrameInfo_t mutableFrame = *frame;
+    auto sequence = vulkan_composite(&mutableFrame, nullptr, false, slot.texture.get(), false, nullptr);
+    MaliRequire(sequence.has_value(), "normal Wayland Gamescope BLIT");
+    g_device.wait(*sequence, false); g_device.m_maliProducerFence = VK_NULL_HANDLE;
+    MaliRequire(*sequence > s.sequence && g_device.completedSeqNo() >= *sequence, "normal monotonic KHR timeline");
+    s.sequence = *sequence; ++s.rendered;
+    dd_interop_input input{}; input.fence = producer.fence;
+    auto sync = NormalInterop(DD_SYNC_EXPORT, input); input = {}; input.sync = sync.sync;
+    NormalInterop(DD_SYNC_WAIT, input); // real producer fence, never a fabricated acquire
+    MaliRequire(s.ownership.ready(index), "normal Rendering -> Ready");
+    dd_normal_input publish{}; publish.token = slot.ahb.token; publish.sync = sync.sync; publish.frame = slot.frame;
+    MaliRequire(MaliResult(NormalRPC(MB_NORMAL_PUBLISH, publish), "normal publish ownership"), "normal publish ownership");
+    MaliRequire(s.ownership.presented(index), "normal Ready -> Android-owned");
+    mali_normal_commit(index); ++s.presented;
+    g_device.wait(*sequence, true);
+    input = {}; input.sync = sync.sync; NormalInterop(DD_SYNC_CLOSE, input);
+    auto destroyFence = (PFN_vkDestroyFence)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDestroyFence");
+    destroyFence(g_device.device(), producer.fence, nullptr);
+    return 0;
+}
+int vulkan_mali_normal_stop() {
+    auto &s = normalOutput; s.stopping = true;
+    if (!s.begun) { g_device.ShutdownMaliDiagnostic(); return 1; }
+    mali_normal_detach_output();
+    VkResult end = NormalRPC(MB_NORMAL_END);
+    if (end != VK_SUCCESS) {
+        ++s.timeouts;
+        for (unsigned i = 0; i < 3; ++i) if (s.ownership.androidOwned(i))
+            std::fprintf(stderr, "normal teardown FAILED token=%u key=%u frame=%u state=ANDROID_OWNED; retained; VkResult=%d no PASS\n", s.slots[i].ahb.token, s.slots[i].key, s.slots[i].frame, int(end));
+        s_maliSessionFailureCleanup = nullptr;
+        g_device.FailMaliDiagnostic("normal Android release drain", end);
+    }
+    // This acknowledgement comes from the actual Android-local release registry,
+    // after every release fence; it is not a timeout assumption.
+    for (unsigned i = 0; i < 3; ++i) if (s.ownership.androidOwned(i)) mali_normal_released(i);
+    mali_normal_destroy_buffers();
+    for (unsigned i = 0; i < 3; ++i) {
+        auto &slot = s.slots[i]; MaliRequire(s.ownership.free(i), "normal output still Android-owned at destruction");
+        slot.texture = nullptr;
+        if (slot.ahb.image) g_device.vk.DestroyImage(g_device.device(), slot.ahb.image, nullptr);
+        if (slot.ahb.memory) g_device.vk.FreeMemory(g_device.device(), slot.ahb.memory, nullptr);
+        if (slot.ahb.token) { dd_interop_input release{}; release.token = slot.ahb.token; NormalInterop(DD_AHB_RELEASE, release); }
+    }
+    s_maliSessionFailureCleanup = nullptr; s_maliSessionCheckCleanup = NormalBaseline;
+    s_maliSessionCheckDestroyed = [] {
+        uint32_t count = 0;
+        MaliRequire(MaliResult(g_device.vk.EnumeratePhysicalDevices(g_device.instance(), &count, nullptr), "normal native device destroy acknowledgement"), "normal native device destroy acknowledgement");
+        MaliRequire(count != 0, "normal physical inventory after device destruction");
+        std::puts("normal native device/implicit queue destruction acknowledged; baseline devices=0 queues=0");
+    };
+    g_device.ShutdownMaliDiagnostic(); s_maliSessionCheckCleanup = nullptr; s_maliSessionCheckDestroyed = nullptr;
+    std::printf("normal session stopped: rendered=%u committed=%u released=%u release timeouts=%u; clean teardown\n", s.rendered, s.presented, s.released, s.timeouts);
+    return 0;
+}
