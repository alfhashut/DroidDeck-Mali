+static const struct wl_surface_interface host_surface_impl = {.destroy = resource_destroy, .commit = host_commit};
+static void host_create_surface(struct wl_client *client, struct wl_resource *resource, uint32_t id) {
+    struct wl_resource *surface = wl_resource_create(client, &wl_surface_interface, wl_resource_get_version(resource), id);
+    wl_resource_set_implementation(surface, &host_surface_impl, NULL, NULL);
+}
+static const struct wl_compositor_interface host_compositor_impl = {.create_surface = host_create_surface};
+static void feedback_destroy(struct wl_resource *resource) { wl_list_remove(wl_resource_get_link(resource)); }
+static void host_feedback_request(struct wl_client *client, struct wl_resource *manager, struct wl_resource *surface, uint32_t id) {
+    (void)manager; (void)surface;
+    struct wl_resource *feedback = wl_resource_create(client, &wp_presentation_feedback_interface, 1, id);
+    wl_resource_set_implementation(feedback, NULL, NULL, feedback_destroy);
+    wl_list_insert(&host_feedback, wl_resource_get_link(feedback));
