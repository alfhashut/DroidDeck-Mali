diff --git a/src/mali_desktop.c b/src/mali_desktop.c
new file mode 100644
--- /dev/null
+++ b/src/mali_desktop.c
@@ -0,0 +1,303 @@
+#include "mali_desktop.h"
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <stdlib.h>
+#include <wayland-client.h>
+#include <presentation-time-client-protocol.h>
+#include <wlr/backend/headless.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/drm_format_set.h>
+#include <wlr/render/pass.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_pointer_constraints_v1.h>
+#include <wlr/types/wlr_presentation_time.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/types/wlr_single_pixel_buffer_v1.h>
+#include <wlr/types/wlr_subcompositor.h>
+#include <wlr/types/wlr_viewporter.h>
+#include <wlr/types/wlr_xdg_shell.h>
+#include <wlr/util/transform.h>
+
+struct mali_desktop {
+    struct wlr_renderer *renderer;
+    struct wlr_seat *seat;
+    struct wlr_backend *backend;
+    struct wlr_output *output;
+    struct wlr_allocator *allocator;
+    struct wlr_buffer *buffer;
+    struct wlr_scene *scene;
+    struct wlr_scene_tree *content, *cursor;
+    struct wlr_xdg_toplevel *toplevel;
+    struct wl_listener new_surface, new_toplevel, new_popup, top_destroy, set_cursor;
+    struct wl_list surfaces, presentations;
+    unsigned presentation_count;
+    int width, height, cursor_x, cursor_y, hotspot_x, hotspot_y;
+    void (*dirty)(void *, struct wlr_surface *);
+    void *data;
+};
+struct surface_watch {
+    struct mali_desktop *desktop;
+    struct wlr_surface *surface;
+    struct wl_list link;
+    struct wl_listener commit, destroy;
+};
+struct feedback_item {
+    struct wl_list link;
+    struct wlr_presentation_feedback *feedback;
+};
+struct presentation {
+    struct mali_desktop *desktop;
+    struct wp_presentation_feedback *outer;
+    struct wl_list link, feedback;
+};
+static void dirty(struct mali_desktop *desktop, struct wlr_surface *surface) {
+    if (desktop->dirty) desktop->dirty(desktop->data, surface);
+}
+static void configure(struct mali_desktop *desktop) {
+    wlr_xdg_toplevel_set_size(desktop->toplevel, desktop->width, desktop->height);
+    wlr_xdg_toplevel_set_fullscreen(desktop->toplevel, true);
+    wlr_xdg_toplevel_set_activated(desktop->toplevel, true);
+}
+static void surface_commit(struct wl_listener *listener, void *data) {
+    (void)data;
+    struct surface_watch *watch = wl_container_of(listener, watch, commit);
+    struct mali_desktop *desktop = watch->desktop;
+    if (desktop->toplevel && watch->surface == desktop->toplevel->base->surface) {
+        if (desktop->toplevel->base->initial_commit) configure(desktop);
+        if (watch->surface->mapped) {
+            struct wlr_keyboard *keyboard = wlr_seat_get_keyboard(desktop->seat);
+            if (keyboard) wlr_seat_keyboard_notify_enter(desktop->seat, watch->surface,
+                keyboard->keycodes, keyboard->num_keycodes, &keyboard->modifiers);
+        }
+    }
+    struct wlr_xdg_surface *xdg = wlr_xdg_surface_try_from_wlr_surface(watch->surface);
+    if (xdg && xdg->role == WLR_XDG_SURFACE_ROLE_POPUP && xdg->initial_commit) {
+        struct wlr_box box = { .width = desktop->width, .height = desktop->height };
+        wlr_xdg_popup_unconstrain_from_box(xdg->popup, &box);
+    }
+    dirty(desktop, watch->surface);
+}
+static void surface_destroy(struct wl_listener *listener, void *data) {
+    (void)data;
+    struct surface_watch *watch = wl_container_of(listener, watch, destroy);
+    dirty(watch->desktop, NULL);
+    wl_list_remove(&watch->commit.link);
+    wl_list_remove(&watch->destroy.link);
+    wl_list_remove(&watch->link);
+    free(watch);
+}
+static void new_surface(struct wl_listener *listener, void *data) {
+    struct mali_desktop *desktop = wl_container_of(listener, desktop, new_surface);
+    struct surface_watch *watch = calloc(1, sizeof(*watch));
+    if (!watch) { wl_client_post_no_memory(wl_resource_get_client(((struct wlr_surface *)data)->resource)); return; }
+    watch->desktop = desktop; watch->surface = data;
+    watch->commit.notify = surface_commit; watch->destroy.notify = surface_destroy;
+    wl_signal_add(&watch->surface->events.commit, &watch->commit);
+    wl_signal_add(&watch->surface->events.destroy, &watch->destroy);
+    wl_list_insert(&desktop->surfaces, &watch->link);
+}
+static void top_destroy(struct wl_listener *listener, void *data) {
+    (void)data;
+    struct mali_desktop *desktop = wl_container_of(listener, desktop, top_destroy);
+    wl_list_remove(&desktop->top_destroy.link); wl_list_init(&desktop->top_destroy.link);
+    desktop->toplevel = NULL;
+    dirty(desktop, NULL);
+}
+static void new_toplevel(struct wl_listener *listener, void *data) {
+    struct mali_desktop *desktop = wl_container_of(listener, desktop, new_toplevel);
+    struct wlr_xdg_toplevel *top = data;
+    if (desktop->toplevel) { wlr_xdg_toplevel_send_close(top); return; }
+    struct wlr_scene_tree *tree = wlr_scene_xdg_surface_create(desktop->content, top->base);
+    if (!tree) { wl_client_post_no_memory(wl_resource_get_client(top->resource)); return; }
+    top->base->data = tree;
+    desktop->toplevel = top;
+    desktop->top_destroy.notify = top_destroy;
+    wl_signal_add(&top->events.destroy, &desktop->top_destroy);
+}
+static void new_popup(struct wl_listener *listener, void *data) {
+    struct mali_desktop *desktop = wl_container_of(listener, desktop, new_popup);
+    struct wlr_xdg_popup *popup = data;
+    struct wlr_xdg_surface *parent = wlr_xdg_surface_try_from_wlr_surface(popup->parent);
+    if (!parent || !parent->data) { wlr_xdg_popup_destroy(popup); return; }
+    popup->base->data = wlr_scene_xdg_surface_create(parent->data, popup->base);
+    if (!popup->base->data) { wl_client_post_no_memory(wl_resource_get_client(popup->resource)); return; }
+}
+static void set_cursor(struct wl_listener *listener, void *data) {
+    struct mali_desktop *desktop = wl_container_of(listener, desktop, set_cursor);
+    struct wlr_seat_pointer_request_set_cursor_event *event = data;
+    if (event->seat_client != desktop->seat->pointer_state.focused_client) return;
+    struct wlr_scene_node *node, *tmp;
+    wl_list_for_each_safe(node, tmp, &desktop->cursor->children, link) wlr_scene_node_destroy(node);
+    desktop->hotspot_x = event->hotspot_x; desktop->hotspot_y = event->hotspot_y;
+    if (event->surface) wlr_scene_subsurface_tree_create(desktop->cursor, event->surface);
+    wlr_scene_node_set_position(&desktop->cursor->node,
+        desktop->cursor_x - desktop->hotspot_x, desktop->cursor_y - desktop->hotspot_y);
+    dirty(desktop, NULL);
+}
+struct mali_desktop *mali_desktop_create(struct wl_display *display, struct wlr_renderer *renderer,
+        struct wlr_compositor *compositor, struct wlr_seat *seat, int width, int height,
+        void (*notify)(void *, struct wlr_surface *), void *data) {
+    struct mali_desktop *desktop = calloc(1, sizeof(*desktop));
+    if (!desktop) return NULL;
+    desktop->renderer = renderer; desktop->seat = seat;
+    desktop->width = width; desktop->height = height; desktop->dirty = notify; desktop->data = data;
+    wl_list_init(&desktop->surfaces); wl_list_init(&desktop->presentations);
+    wl_list_init(&desktop->new_surface.link); wl_list_init(&desktop->new_toplevel.link);
+    wl_list_init(&desktop->new_popup.link); wl_list_init(&desktop->top_destroy.link); wl_list_init(&desktop->set_cursor.link);
+    // Constraints have wlroots validation/lifetimes, but remain inactive by policy.
+    struct wlr_xdg_shell *shell = wlr_xdg_shell_create(display, 3);
+    if (!shell || !wlr_subcompositor_create(display) || !wlr_single_pixel_buffer_manager_v1_create(display) ||
+            !wlr_viewporter_create(display) || !wlr_pointer_constraints_v1_create(display) ||
+            !wlr_presentation_create(display, NULL, 1)) goto fail;
+    desktop->scene = wlr_scene_create();
+    if (!desktop->scene) goto fail;
+    desktop->content = wlr_scene_tree_create(&desktop->scene->tree);
+    desktop->cursor = wlr_scene_tree_create(&desktop->scene->tree);
+    desktop->backend = wlr_headless_backend_create(wl_display_get_event_loop(display));
+    if (!desktop->content || !desktop->cursor || !desktop->backend) goto fail;
+    // This output supplies wl_output metadata only. Presentation comes from Android.
+    desktop->output = wlr_headless_add_output(desktop->backend, width, height);
+    desktop->allocator = wlr_allocator_autocreate(desktop->backend, renderer);
+    if (!desktop->output || !desktop->allocator) goto fail;
+    wlr_output_create_global(desktop->output, display);
+    struct wlr_drm_format_set formats = {0};
+    bool format_ok = wlr_drm_format_set_add(&formats, DRM_FORMAT_ARGB8888, DRM_FORMAT_MOD_LINEAR);
+    if (format_ok) desktop->buffer = wlr_allocator_create_buffer(desktop->allocator, width, height,
+        wlr_drm_format_set_get(&formats, DRM_FORMAT_ARGB8888));
+    wlr_drm_format_set_finish(&formats);
+    if (!desktop->buffer) goto fail;
+    desktop->new_surface.notify = new_surface; wl_signal_add(&compositor->events.new_surface, &desktop->new_surface);
+    desktop->new_toplevel.notify = new_toplevel; wl_signal_add(&shell->events.new_toplevel, &desktop->new_toplevel);
+    desktop->new_popup.notify = new_popup; wl_signal_add(&shell->events.new_popup, &desktop->new_popup);
+    desktop->set_cursor.notify = set_cursor; wl_signal_add(&seat->events.request_set_cursor, &desktop->set_cursor);
+    return desktop;
+fail:
+    mali_desktop_destroy(desktop);
+    return NULL;
+}
+struct wlr_surface *mali_desktop_surface(struct mali_desktop *desktop) {
+    return desktop->toplevel && desktop->toplevel->base->surface->mapped ? desktop->toplevel->base->surface : NULL;
+}
+struct wlr_surface *mali_desktop_pointer(struct mali_desktop *desktop, double x, double y, double *sx, double *sy) {
+    desktop->cursor_x = (int)x; desktop->cursor_y = (int)y;
+    wlr_scene_node_set_position(&desktop->cursor->node, (int)x - desktop->hotspot_x, (int)y - desktop->hotspot_y);
+    dirty(desktop, NULL);
+    struct wlr_scene_node *node = wlr_scene_node_at(&desktop->content->node, x, y, sx, sy);
+    if (!node || node->type != WLR_SCENE_NODE_BUFFER) return NULL;
+    struct wlr_scene_surface *surface = wlr_scene_surface_try_from_buffer(wlr_scene_buffer_from_node(node));
+    return surface ? surface->surface : NULL;
+}
+struct render {
+    struct mali_desktop *desktop;
+    struct wlr_render_pass *pass;
+    bool ok;
+};
+static void render_buffer(struct wlr_scene_buffer *node, int x, int y, void *data) {
+    struct render *render = data;
+    if (!node->buffer || node->opacity == 0) return;
+    struct wlr_scene_surface *surface = wlr_scene_surface_try_from_buffer(node);
+    if (surface) wlr_surface_send_enter(surface->surface, render->desktop->output);
+    struct wlr_texture *texture = wlr_texture_from_buffer(render->desktop->renderer, node->buffer);
+    if (!texture) { render->ok = false; return; }
+    int width = node->dst_width, height = node->dst_height;
+    if (!width || !height) {
+        width = texture->width; height = texture->height;
+        wlr_output_transform_coords(node->transform, &width, &height);
+    }
+    wlr_render_pass_add_texture(render->pass, &(struct wlr_render_texture_options){
+        .texture = texture, .src_box = node->src_box,
+        .dst_box = {x, y, width, height}, .alpha = &node->opacity,
+        .transform = wlr_output_transform_invert(node->transform), .filter_mode = node->filter_mode,
+    });
+    wlr_texture_destroy(texture);
+}
+struct wlr_buffer *mali_desktop_render(struct mali_desktop *desktop) {
+    struct render render = { .desktop = desktop, .ok = true,
+        .pass = wlr_renderer_begin_buffer_pass(desktop->renderer, desktop->buffer, NULL) };
+    if (!render.pass) return NULL;
+    wlr_render_pass_add_rect(render.pass, &(struct wlr_render_rect_options){
+        .box = {0, 0, desktop->width, desktop->height}, .color = {0, 0, 0, 1}, .blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+    });
+    wlr_scene_node_for_each_buffer(&desktop->scene->tree.node, render_buffer, &render);
+    bool submitted = wlr_render_pass_submit(render.pass);
+    return submitted && render.ok ? desktop->buffer : NULL;
+}
+static void frame_done(struct wlr_scene_buffer *buffer, int x, int y, void *data) {
+    (void)x; (void)y;
+    if (!buffer->buffer || buffer->opacity == 0) return;
+    struct wlr_scene_surface *surface = wlr_scene_surface_try_from_buffer(buffer);
+    if (surface) wlr_surface_send_frame_done(surface->surface, data);
+}
+void mali_desktop_frame_done(struct mali_desktop *desktop, const struct timespec *when) {
+    wlr_scene_node_for_each_buffer(&desktop->scene->tree.node, frame_done, (void *)when);
+}
+static void presentation_destroy(struct presentation *presentation) {
+    struct feedback_item *item, *tmp;
+    wl_list_for_each_safe(item, tmp, &presentation->feedback, link) {
+        wlr_presentation_feedback_destroy(item->feedback); wl_list_remove(&item->link); free(item);
+    }
+    wp_presentation_feedback_destroy(presentation->outer);
+    wl_list_remove(&presentation->link); --presentation->desktop->presentation_count; free(presentation);
+}
+static void sync_output(void *data, struct wp_presentation_feedback *feedback, struct wl_output *output) {
+    (void)data; (void)feedback; (void)output;
+}
+static void presented(void *data, struct wp_presentation_feedback *feedback, uint32_t sec_hi, uint32_t sec_lo,
+        uint32_t ns, uint32_t refresh, uint32_t seq_hi, uint32_t seq_lo, uint32_t flags) {
+    (void)feedback;
+    struct presentation *presentation = data;
+    struct wlr_presentation_event event = {
+        .output = presentation->desktop->output, .tv_sec = ((uint64_t)sec_hi << 32) | sec_lo,
+        .tv_nsec = ns, .refresh = refresh, .seq = ((uint64_t)seq_hi << 32) | seq_lo,
+        .flags = flags & ~WP_PRESENTATION_FEEDBACK_KIND_ZERO_COPY,
+    };
+    struct feedback_item *item;
+    wl_list_for_each(item, &presentation->feedback, link) wlr_presentation_feedback_send_presented(item->feedback, &event);
+    presentation_destroy(presentation);
+}
+static void discarded(void *data, struct wp_presentation_feedback *feedback) {
+    (void)feedback; presentation_destroy(data);
+}
+static const struct wp_presentation_feedback_listener presentation_listener = {sync_output, presented, discarded};
+static void sample(struct wlr_scene_buffer *buffer, int x, int y, void *data) {
+    (void)x; (void)y;
+    struct presentation *presentation = data;
+    if (!buffer->buffer || buffer->opacity == 0) return;
+    struct wlr_scene_surface *surface = wlr_scene_surface_try_from_buffer(buffer);
+    if (!surface) return;
+    struct wlr_presentation_feedback *feedback = wlr_presentation_surface_sampled(surface->surface);
+    if (!feedback) return;
+    struct feedback_item *item = calloc(1, sizeof(*item));
+    if (!item) { wlr_presentation_feedback_destroy(feedback); return; }
+    item->feedback = feedback; wl_list_insert(&presentation->feedback, &item->link);
+}
+bool mali_desktop_queue_presentation(struct mali_desktop *desktop, struct wp_presentation *outer, struct wl_surface *surface) {
+    if (!outer || desktop->presentation_count >= 64) return false;
+    struct presentation *presentation = calloc(1, sizeof(*presentation));
+    if (!presentation) return false;
+    presentation->desktop = desktop; wl_list_init(&presentation->feedback);
+    presentation->outer = wp_presentation_feedback(outer, surface);
+    if (!presentation->outer) { free(presentation); return false; }
+    wl_list_insert(&desktop->presentations, &presentation->link); ++desktop->presentation_count;
+    wp_presentation_feedback_add_listener(presentation->outer, &presentation_listener, presentation);
+    wlr_scene_node_for_each_buffer(&desktop->scene->tree.node, sample, presentation);
+    return true;
+}
+void mali_desktop_destroy(struct mali_desktop *desktop) {
+    if (!desktop) return;
+    struct presentation *presentation, *tmp;
+    wl_list_for_each_safe(presentation, tmp, &desktop->presentations, link) presentation_destroy(presentation);
+    struct surface_watch *watch, *next;
+    wl_list_for_each_safe(watch, next, &desktop->surfaces, link) surface_destroy(&watch->destroy, NULL);
+    wl_list_remove(&desktop->new_surface.link); wl_list_remove(&desktop->new_toplevel.link);
+    wl_list_remove(&desktop->new_popup.link); wl_list_remove(&desktop->top_destroy.link); wl_list_remove(&desktop->set_cursor.link);
+    if (desktop->scene) wlr_scene_node_destroy(&desktop->scene->tree.node);
+    if (desktop->buffer) wlr_buffer_drop(desktop->buffer);
+    if (desktop->allocator) wlr_allocator_destroy(desktop->allocator);
+    if (desktop->backend) wlr_backend_destroy(desktop->backend);
+    free(desktop);
+}
