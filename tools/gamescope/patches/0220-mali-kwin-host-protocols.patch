+static const struct wp_presentation_interface host_presentation_impl = {.destroy = resource_destroy, .feedback = host_feedback_request};
+static void host_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id) {
+    const struct wl_interface *interface = data;
+    struct wl_resource *resource = wl_resource_create(client, interface, version, id);
+    wl_resource_set_implementation(resource, interface == &wl_compositor_interface ?
+        (const void *)&host_compositor_impl : (const void *)&host_presentation_impl, NULL, NULL);
+    if (interface == &wp_presentation_interface) wp_presentation_send_clock_id(resource, CLOCK_MONOTONIC);
+}
+static pid_t outer_server(int *client_fd) {
+    int sockets[2]; assert(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sockets) == 0);
+    pid_t pid = fork(); assert(pid >= 0);
+    if (!pid) {
+        close(sockets[0]); wl_list_init(&host_feedback);
+        struct wl_display *display = wl_display_create(); assert(display && wl_client_create(display, sockets[1]));
+        assert(wl_global_create(display, &wl_compositor_interface, 4, (void *)&wl_compositor_interface, host_bind));
+        assert(wl_global_create(display, &wp_presentation_interface, 1, (void *)&wp_presentation_interface, host_bind));
+        wl_display_run(display); _Exit(0);
+    }
+    close(sockets[1]); *client_fd = sockets[0]; return pid;
+}
+static void outer_global(void *data, struct wl_registry *registry, uint32_t name, const char *interface, uint32_t version) {
+    (void)data; (void)version;
+    if (!strcmp(interface, "wl_compositor")) compositor = wl_registry_bind(registry, name, &wl_compositor_interface, 4);
+    if (!strcmp(interface, "wp_presentation")) presentation = wl_registry_bind(registry, name, &wp_presentation_interface, 1);
+}
+static void check_pixels(struct mali_desktop *desktop, char command) {
+    struct wlr_buffer *buffer = mali_desktop_render(desktop); assert(buffer);
+    void *pixels; uint32_t format; size_t stride;
+    assert(wlr_buffer_begin_data_ptr_access(buffer, WLR_BUFFER_DATA_PTR_ACCESS_READ, &pixels, &format, &stride));
+    for (int y = 0; y < 6; ++y) for (int x = 0; x < 8; ++x) {
+        uint32_t color = 0xff000000;
+        if (command != 'B' && x >= 2 && x < (command == 'C' ? 4 : 6) && y >= 1 && y < 5)
+            color = command == 'R' ? 0xffff0000 : 0xff0000ff;
+        assert(((uint32_t *)((char *)pixels + y * stride))[x] == color);
+    }
+    wlr_buffer_end_data_ptr_access(buffer);
+}
+int main(int argc, char **argv) {
+    (void)argv; bool invalid = argc > 1;
+    char runtime[] = "/tmp/mali-protocols-XXXXXX"; assert(mkdtemp(runtime)); assert(setenv("XDG_RUNTIME_DIR", runtime, 1) == 0);
+    struct wl_display *display = wl_display_create(); assert(display);
+    assert(wl_display_add_socket(display, "wayland-0") == 0);
+    const char *socket = wl_display_add_socket_auto(display); assert(socket && strcmp(socket, "wayland-0"));
+    struct wlr_renderer *renderer = wlr_pixman_renderer_create(); assert(renderer && wlr_renderer_init_wl_display(renderer, display));
+    struct wlr_compositor *compositor_server = wlr_compositor_create(display, 5, renderer);
+    struct wlr_seat *seat_server = wlr_seat_create(display, "test"); assert(compositor_server && seat_server);
+    wlr_seat_set_capabilities(seat_server, WL_SEAT_CAPABILITY_POINTER);
+    struct mali_desktop *desktop = mali_desktop_create(display, renderer, compositor_server, seat_server, 8, 6, NULL, NULL); assert(desktop);
+    int channel[2]; assert(socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, channel) == 0);
+    pid_t child = fork(); assert(child >= 0);
+    if (!child) {
+        close(channel[0]);
+        struct wl_display *connection = wl_display_connect(socket); assert(connection);
+        int fd = dup(wl_display_get_fd(connection)); wl_display_disconnect(connection); assert(fd >= 0);
+        client(fd, channel[1], invalid); fflush(stdout); _Exit(0);
+    }
+    close(channel[1]);
+    int outer_fd; pid_t outer = outer_server(&outer_fd);
+    struct wl_display *outer_display = wl_display_connect_to_fd(outer_fd); assert(outer_display);
+    struct wl_registry *registry = wl_display_get_registry(outer_display);
+    const struct wl_registry_listener listener = {outer_global, removed}; wl_registry_add_listener(registry, &listener, NULL);
+    assert(wl_display_roundtrip(outer_display) >= 0 && compositor && presentation);
+    struct wl_surface *outer_surface = wl_compositor_create_surface(compositor);
+    int status;
+    while (waitpid(child, &status, WNOHANG) == 0) {
+        assert(wl_event_loop_dispatch(wl_display_get_event_loop(display), 1) >= 0); wl_display_flush_clients(display);
+        struct pollfd pollfd = {.fd = channel[0], .events = POLLIN};
+        if (poll(&pollfd, 1, 0) <= 0 || !(pollfd.revents & POLLIN)) continue;
+        char command; if (read(channel[0], &command, 1) != 1) continue;
+        if (command == 'N') assert(!mali_desktop_surface(desktop));
+        else if (command == 'P' || command == 'D' || command == 'Q') {
+            assert(mali_desktop_queue_presentation(desktop, presentation, outer_surface));
+            if (command != 'Q') {
+                wl_surface_commit(outer_surface);
+                assert(wl_display_roundtrip(outer_display) >= 0);
+            }
+            if (command == 'P') { struct timespec time; clock_gettime(CLOCK_MONOTONIC, &time); mali_desktop_frame_done(desktop, &time); }
+        } else check_pixels(desktop, command);
+        wl_display_flush_clients(display); assert(write(channel[0], &command, 1) == 1);
+    }
+    assert(WIFEXITED(status) && WEXITSTATUS(status) == 0);
+    wl_display_destroy_clients(display); mali_desktop_destroy(desktop); wlr_seat_destroy(seat_server);
+    wl_display_destroy(display); wlr_renderer_destroy(renderer);
+    wl_surface_destroy(outer_surface); wl_display_disconnect(outer_display);
+    kill(outer, SIGTERM); assert(waitpid(outer, &status, 0) == outer); close(channel[0]); assert(rmdir(runtime) == 0);
+    puts("KWin host protocol bind/use and lifecycle: PASS"); return 0;
+}
