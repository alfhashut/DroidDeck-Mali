+static struct wl_list host_feedback;
+static unsigned host_commits;
+static void resource_destroy(struct wl_client *client, struct wl_resource *resource) { (void)client; wl_resource_destroy(resource); }
+static void host_commit(struct wl_client *client, struct wl_resource *surface) {
+    (void)client; (void)surface; ++host_commits;
+    struct wl_resource *feedback, *tmp;
+    wl_resource_for_each_safe(feedback, tmp, &host_feedback) {
+        if (host_commits == 1) wp_presentation_feedback_send_presented(feedback, 1, 23, 456, 16666666, 2, 42,
+            WP_PRESENTATION_FEEDBACK_KIND_VSYNC | WP_PRESENTATION_FEEDBACK_KIND_ZERO_COPY);
+        else wp_presentation_feedback_send_discarded(feedback);
+        wl_resource_destroy(feedback);
+    }
