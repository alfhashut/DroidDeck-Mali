diff --git a/src/frame_trace.h b/src/frame_trace.h
new file mode 100644
index 0000000..aa07a8a
--- /dev/null
+++ b/src/frame_trace.h
@@ -0,0 +1,98 @@
+/* Development-only journal. No renderer/wire/ownership changes. */
+#ifndef DD_FRAME_TRACE_H
+#define DD_FRAME_TRACE_H
+#include <stdint.h>
+#ifdef __cplusplus
+extern "C" {
+#endif
+enum dd_ft_stage {
+    DD_FT_COMMIT, DD_FT_SELECT, DD_FT_COALESCE, DD_FT_DISCARD,
+    DD_FT_FRAME_BEGIN, DD_FT_FRAME_END, DD_FT_SHM_BEGIN, DD_FT_SHM_END,
+    DD_FT_ACQUIRE_BEGIN, DD_FT_ACQUIRE_END, DD_FT_RENDER_BEGIN, DD_FT_RENDER_END,
+    DD_FT_WAIT_BEGIN, DD_FT_WAIT_END, DD_FT_SUBMIT_BEGIN, DD_FT_SUBMIT_END,
+    DD_FT_PUBLISH, DD_FT_OUTER_COMMIT, DD_FT_OUTER_RELEASE, DD_FT_POOL_BLOCKED,
+    DD_FT_HANDOFF_BEGIN, DD_FT_HANDOFF_END, DD_FT_ANDROID_SUBMIT, DD_FT_ANDROID_REPEAT,
+    DD_FT_RELEASE_CALLBACK, DD_FT_RELEASE_QUEUED, DD_FT_RELEASE_FENCE_PENDING,
+    DD_FT_RELEASE_FENCE_OBSERVED, DD_FT_POOL_RETURN, DD_FT_CANCEL,
+    DD_FT_TRANSACTION_COMPLETE, DD_FT_LATCH_TIME, DD_FT_COPY_BEGIN, DD_FT_COPY_END,
+    DD_FT_SHM_LOOKUP_BEGIN, DD_FT_SHM_LOOKUP_END, DD_FT_SHM_SOURCE_BEGIN, DD_FT_SHM_SOURCE_END,
+    DD_FT_STAGING_ACQUIRE_BEGIN, DD_FT_STAGING_ACQUIRE_END,
+    DD_FT_STAGING_CREATE_BEGIN, DD_FT_STAGING_CREATE_END,
+    DD_FT_STAGING_MAP_BEGIN, DD_FT_STAGING_MAP_END,
+    DD_FT_STAGING_VALIDATE_BEGIN, DD_FT_STAGING_VALIDATE_END,
+    DD_FT_SHM_SOURCE_RELEASE_BEGIN, DD_FT_SHM_SOURCE_RELEASE_END,
+    DD_FT_TEXTURE_CREATE_BEGIN, DD_FT_TEXTURE_CREATE_END,
+    DD_FT_UPLOAD_RECORD_BEGIN, DD_FT_UPLOAD_RECORD_END,
+    DD_FT_UPLOAD_PREPARE_BEGIN, DD_FT_UPLOAD_PREPARE_END,
+    DD_FT_UPLOAD_SUBMIT_BEGIN, DD_FT_UPLOAD_SUBMIT_END,
+    DD_FT_UPLOAD_FINALIZE_BEGIN, DD_FT_UPLOAD_FINALIZE_END,
+    DD_FT_UPLOAD_QUEUE_BEGIN, DD_FT_UPLOAD_QUEUE_END,
+    DD_FT_UPLOAD_WAIT_BEGIN, DD_FT_UPLOAD_WAIT_END,
+    DD_FT_SHM_CLEANUP_BEGIN, DD_FT_SHM_CLEANUP_END,
+    DD_FT_PROXY_PREPARE_BEGIN, DD_FT_PROXY_PREPARE_END,
+    DD_FT_PROXY_LOCK_BEGIN, DD_FT_PROXY_LOCK_END,
+    DD_FT_PROXY_MIRROR_BEGIN, DD_FT_PROXY_MIRROR_END,
+    DD_FT_PROXY_BULK_SETUP_BEGIN, DD_FT_PROXY_BULK_SETUP_END,
+    DD_FT_PROXY_BULK_PACK_BEGIN, DD_FT_PROXY_BULK_PACK_END,
+    DD_FT_PROXY_BULK_RPC_BEGIN, DD_FT_PROXY_BULK_RPC_END,
+    DD_FT_PROXY_BULK_ACK_BEGIN, DD_FT_PROXY_BULK_ACK_END,
+    DD_FT_PROXY_SUBMIT_PACK_BEGIN, DD_FT_PROXY_SUBMIT_PACK_END,
+    DD_FT_PROXY_SUBMIT_RPC_BEGIN, DD_FT_PROXY_SUBMIT_RPC_END,
+    DD_FT_PROXY_REPLY_HANDLE_BEGIN, DD_FT_PROXY_REPLY_HANDLE_END,
+    DD_FT_PROXY_FINALIZE_BEGIN, DD_FT_PROXY_FINALIZE_END,
+    DD_FT_RPC_HEADER_BEGIN, DD_FT_RPC_HEADER_END,
+    DD_FT_RPC_SEND_BEGIN, DD_FT_RPC_SEND_END,
+    DD_FT_RPC_RECEIVE_BEGIN, DD_FT_RPC_RECEIVE_END,
+    DD_FT_RPC_DECODE_BEGIN, DD_FT_RPC_DECODE_END,
+    DD_FT_BROKER_RECEIVE_BEGIN, DD_FT_BROKER_RECEIVE_END,
+    DD_FT_BROKER_DISPATCH_BEGIN, DD_FT_BROKER_DISPATCH_END,
+    DD_FT_BROKER_REPLY_BEGIN, DD_FT_BROKER_REPLY_END,
+    DD_FT_BROKER_MAPPED_COPY_BEGIN, DD_FT_BROKER_MAPPED_COPY_END,
+    DD_FT_PROXY_DIRTY_BEGIN, DD_FT_PROXY_DIRTY_END,
+    DD_FT_RPC_EXCHANGE_BEGIN, DD_FT_RPC_EXCHANGE_END,
+    DD_FT_PROXY_SUBMIT_LINK, DD_FT_PROXY_DETAIL_POLICY,
+    DD_FT_PROXY_SHARED_RPC_BEGIN, DD_FT_PROXY_SHARED_RPC_END,
+    DD_FT_BROKER_SHARED_COPY_BEGIN, DD_FT_BROKER_SHARED_COPY_END, DD_FT_COUNT
+};
+/* Diagnostic-only ordered-stream sampler. Both endpoints count fence-less
+ * MB_RENDERER_SUBMIT requests since MB_NORMAL_BEGIN. Bulk writes precede that
+ * submit, so select the NEXT ordinal. No wire metadata, locks or RPC changes. */
+#define DD_FT_UPLOAD_DETAIL_STRIDE 16u
+static inline int dd_ft_upload_detail_selected(uint64_t completed) {
+    return completed % DD_FT_UPLOAD_DETAIL_STRIDE == DD_FT_UPLOAD_DETAIL_STRIDE - 1;
+}
+/* fence is the broker producer-fence resource ID, not a VkFence handle or FD.
+ * sync is the broker resource ID of the exported SYNC_FD wrapper, not its FD. */
+struct dd_ft_id { uint64_t client, attempt, scope; uint32_t frame, key, sync, fence; };
+typedef void (*dd_ft_sink)(enum dd_ft_stage, struct dd_ft_id, uint64_t, uint64_t, int32_t, int);
+/* Private in-process ICD callback. Context is thread-local and cleared after
+ * QueueSubmit. scope becomes a process-local connection pointer identity;
+ * it is never a native fence, FD, or cross-process wire ID. */
+typedef void (*PFN_dd_ft_context)(void *device, dd_ft_sink, const struct dd_ft_id *);
+/* Call init only at normal-session start, after an explicit adb-created arm
+ * marker. Disabled calls do no clocks, locks, allocations, or file access. */
+void dd_ft_init(const char *role);
+void dd_ft_shutdown(void);
+int dd_ft_active(void);
+/* Native-only diagnostic namespace; never sent over the renderer protocol. */
+uint64_t dd_ft_new_scope(void);
+void dd_ft_event(enum dd_ft_stage stage, struct dd_ft_id id,
+                 uint64_t object, uint64_t value, int32_t status, int sample_cpu);
+#ifdef __cplusplus
+}
+struct DDFrameScope {
+    dd_ft_stage end; dd_ft_id id; uint64_t object, value;
+    DDFrameScope(dd_ft_stage begin, dd_ft_stage finishStage, dd_ft_id identity,
+                 uint64_t obj = 0, uint64_t val = 0, bool enabled = true)
+        : end(enabled ? finishStage : DD_FT_COUNT), id(identity), object(obj), value(val) {
+        if (enabled) dd_ft_event(begin, id, object, value, 0, 1);
+    }
+    DDFrameScope(const DDFrameScope &) = delete;
+    DDFrameScope &operator=(const DDFrameScope &) = delete;
+    void finish() {
+        if (end != DD_FT_COUNT) { dd_ft_event(end, id, object, value, 0, 1); end = DD_FT_COUNT; }
+    }
+    ~DDFrameScope() { finish(); }
+};
+#endif
+#endif
diff --git a/src/frame_trace.inc b/src/frame_trace.inc
new file mode 100644
index 0000000..5fd4c55
--- /dev/null
+++ b/src/frame_trace.inc
@@ -0,0 +1,195 @@
+/* Compiled once into maliahb, and once into the normal Gamescope TU.
+ * Armed at startup only. A worker handles control/output off the hot path.
+ * Records stop at capacity; never overwrite and silently lose frame identity.
+ */
+#ifndef _GNU_SOURCE
+#define _GNU_SOURCE
+#endif
+#include "frame_trace.h"
+#include <errno.h>
+#include <inttypes.h>
+#include <pthread.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/syscall.h>
+#include <time.h>
+#include <unistd.h>
+#ifndef DD_FT_ROOT
+#define DD_FT_ROOT NULL
+#endif
+#ifndef DD_FT_CAPACITY
+#define DD_FT_CAPACITY 65536u
+#endif
+struct dd_ft_record {
+    uint64_t wall, cpu, object, value;
+    struct dd_ft_id id;
+    uint32_t tid, stage;
+    int32_t status;
+};
+static const char *dd_ft_names[] = {
+    "client_commit", "client_select", "client_coalesced", "client_discarded",
+    "frame_begin", "frame_end", "shm_import_begin", "shm_import_end",
+    "ahb_acquire_begin", "ahb_acquire_end", "render_begin", "render_end",
+    "wait_begin", "wait_end", "vk_submit_begin", "vk_submit_end",
+    "publish", "outer_commit", "outer_release", "output_pool_blocked",
+    "android_handoff_begin", "android_handoff_end", "android_submit", "android_repeat",
+    "release_callback", "release_queued", "release_fence_pending",
+    "release_fence_observed", "pool_return", "cancel_unsubmitted",
+    "transaction_complete", "android_latch_time", "shm_copy_begin", "shm_copy_end",
+    "shm_lookup_begin", "shm_lookup_end", "shm_source_begin", "shm_source_end",
+    "staging_acquire_begin", "staging_acquire_end", "staging_create_begin", "staging_create_end",
+    "staging_map_begin", "staging_map_end", "staging_validate_begin", "staging_validate_end",
+    "shm_source_release_begin", "shm_source_release_end", "texture_create_begin", "texture_create_end",
+    "upload_record_begin", "upload_record_end", "upload_prepare_begin", "upload_prepare_end",
+    "upload_submit_begin", "upload_submit_end", "upload_finalize_begin", "upload_finalize_end",
+    "upload_queue_begin", "upload_queue_end", "upload_wait_begin", "upload_wait_end",
+    "shm_cleanup_begin", "shm_cleanup_end",
+    "proxy_prepare_begin", "proxy_prepare_end",
+    "proxy_lock_begin", "proxy_lock_end",
+    "proxy_mirror_begin", "proxy_mirror_end",
+    "proxy_bulk_setup_begin", "proxy_bulk_setup_end",
+    "proxy_bulk_pack_begin", "proxy_bulk_pack_end",
+    "proxy_bulk_rpc_begin", "proxy_bulk_rpc_end",
+    "proxy_bulk_ack_begin", "proxy_bulk_ack_end",
+    "proxy_submit_pack_begin", "proxy_submit_pack_end",
+    "proxy_submit_rpc_begin", "proxy_submit_rpc_end",
+    "proxy_reply_handle_begin", "proxy_reply_handle_end",
+    "proxy_finalize_begin", "proxy_finalize_end",
+    "rpc_header_begin", "rpc_header_end",
+    "rpc_send_begin", "rpc_send_end",
+    "rpc_receive_begin", "rpc_receive_end",
+    "rpc_decode_begin", "rpc_decode_end",
+    "broker_receive_begin", "broker_receive_end",
+    "broker_dispatch_begin", "broker_dispatch_end",
+    "broker_reply_begin", "broker_reply_end",
+    "broker_mapped_copy_begin", "broker_mapped_copy_end",
+    "proxy_dirty_begin", "proxy_dirty_end",
+    "rpc_exchange_begin", "rpc_exchange_end",
+    "proxy_submit_link", "proxy_detail_policy",
+    "proxy_shared_rpc_begin", "proxy_shared_rpc_end",
+    "broker_shared_copy_begin", "broker_shared_copy_end"
+};
+static pthread_mutex_t dd_ft_lock = PTHREAD_MUTEX_INITIALIZER;
+static pthread_t dd_ft_thread;
+static struct dd_ft_record *dd_ft_records;
+static unsigned dd_ft_used, dd_ft_enabled, dd_ft_running, dd_ft_stop, dd_ft_dropped;
+static uint64_t dd_ft_run, dd_ft_start, dd_ft_end, dd_ft_last_run, dd_ft_ready_ns;
+static unsigned dd_ft_cpu_stride = 8;
+static const char *dd_ft_role;
+static char dd_ft_root[400];
+static __thread uint32_t dd_ft_tid;
+static uint64_t dd_ft_scope_sequence;
+uint64_t dd_ft_new_scope(void) { return __atomic_add_fetch(&dd_ft_scope_sequence, 1, __ATOMIC_RELAXED); }
+static uint64_t dd_ft_now(clockid_t clock) {
+    struct timespec t;
+    return clock_gettime(clock, &t) ? 0 : (uint64_t)t.tv_sec * UINT64_C(1000000000) + (uint64_t)t.tv_nsec;
+}
+#define DD_FT_ON (1u << 31)
+int dd_ft_active(void) { return (__atomic_load_n(&dd_ft_enabled, __ATOMIC_ACQUIRE) & DD_FT_ON) != 0; }
+void dd_ft_event(enum dd_ft_stage stage, struct dd_ft_id id,
+                 uint64_t object, uint64_t value, int32_t status, int sample_cpu) {
+    unsigned gate = __atomic_load_n(&dd_ft_enabled, __ATOMIC_ACQUIRE);
+    do { if (!(gate & DD_FT_ON)) return; }
+    while (!__atomic_compare_exchange_n(&dd_ft_enabled, &gate, gate+1, 0, __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE));
+    uint64_t wall = dd_ft_now(CLOCK_MONOTONIC);
+    /* Never wait behind journal I/O or another observer. Drop with accounting. */
+    if (pthread_mutex_trylock(&dd_ft_lock)) {
+        __atomic_add_fetch(&dd_ft_dropped, 1, __ATOMIC_RELAXED);
+        __atomic_sub_fetch(&dd_ft_enabled, 1, __ATOMIC_RELEASE); return;
+    }
+    if (wall < dd_ft_start || wall >= dd_ft_end) {
+        pthread_mutex_unlock(&dd_ft_lock); __atomic_sub_fetch(&dd_ft_enabled, 1, __ATOMIC_RELEASE); return;
+    }
+    if ((unsigned)stage >= DD_FT_COUNT || dd_ft_used == DD_FT_CAPACITY || !wall) {
+        __atomic_add_fetch(&dd_ft_dropped, 1, __ATOMIC_RELAXED);
+    } else {
+        struct dd_ft_record *r = &dd_ft_records[dd_ft_used++];
+        r->wall = wall; r->cpu = 0; r->id = id; r->stage = stage;
+        r->object = object; r->value = value; r->status = status;
+        if (!dd_ft_tid) dd_ft_tid = (uint32_t)syscall(SYS_gettid);
+        r->tid = dd_ft_tid;
+        uint64_t sequence = id.attempt ? id.attempt : id.frame ? id.frame : id.client ? id.client : id.fence ? id.fence : value;
+        if (sample_cpu && sequence && sequence % dd_ft_cpu_stride == 0)
+            r->cpu = dd_ft_now(CLOCK_THREAD_CPUTIME_ID);
+    }
+    pthread_mutex_unlock(&dd_ft_lock);
+    __atomic_sub_fetch(&dd_ft_enabled, 1, __ATOMIC_RELEASE);
+}
+static void dd_ft_dump(int complete) {
+    __atomic_fetch_and(&dd_ft_enabled, ~DD_FT_ON, __ATOMIC_ACQ_REL);
+    while (__atomic_load_n(&dd_ft_enabled, __ATOMIC_ACQUIRE)) {
+        struct timespec delay = {0, 1000000}; nanosleep(&delay, NULL);
+    }
+    pthread_mutex_lock(&dd_ft_lock);
+    char path[512];
+    snprintf(path, sizeof(path), "%s/trace-%" PRIu64 "-%d-%s.jsonl", dd_ft_root, dd_ft_run, (int)getpid(), dd_ft_role);
+    FILE *file = fopen(path, "wx");
+    if (file) {
+        fprintf(file, "{\"type\":\"header\",\"version\":1,\"run\":%" PRIu64 ",\"pid\":%d,\"role\":\"%s\",\"clock\":\"CLOCK_MONOTONIC\",\"start_ns\":%" PRIu64 ",\"end_ns\":%" PRIu64 ",\"cpu_stride\":%u,\"capacity\":%u,\"ready_ns\":%" PRIu64 "}\n",
+                dd_ft_run, (int)getpid(), dd_ft_role, dd_ft_start, dd_ft_end, dd_ft_cpu_stride, DD_FT_CAPACITY, dd_ft_ready_ns);
+        for (unsigned i = 0; i < dd_ft_used; ++i) {
+            const struct dd_ft_record *r = &dd_ft_records[i];
+            fprintf(file, "{\"type\":\"event\",\"event_seq\":%u,\"stage\":\"%s\",\"mono_ns\":%" PRIu64 ",\"cpu_ns\":%" PRIu64 ",\"tid\":%u,\"client\":%" PRIu64 ",\"attempt\":%" PRIu64 ",\"scope\":%" PRIu64 ",\"frame\":%u,\"key\":%u,\"sync\":%u,\"fence\":%u,\"object\":%" PRIu64 ",\"value\":%" PRIu64 ",\"status\":%d}\n",
+                    i+1, dd_ft_names[r->stage], r->wall, r->cpu, r->tid, r->id.client, r->id.attempt, r->id.scope,
+                    r->id.frame, r->id.key, r->id.sync, r->id.fence, r->object, r->value, r->status);
+        }
+        fprintf(file, "{\"type\":\"footer\",\"count\":%u,\"dropped\":%u,\"complete\":%s}\n",
+                dd_ft_used, __atomic_load_n(&dd_ft_dropped, __ATOMIC_RELAXED), complete ? "true" : "false");
+        if (fclose(file)) fprintf(stderr, "DroidDeck frame trace output failed: %s\n", strerror(errno));
+    } else fprintf(stderr, "DroidDeck frame trace open failed: %s\n", strerror(errno));
+    dd_ft_last_run = dd_ft_run;
+    pthread_mutex_unlock(&dd_ft_lock);
+}
+static void *dd_ft_worker(void *unused) {
+    (void)unused;
+    dd_ft_records = (struct dd_ft_record *)calloc(DD_FT_CAPACITY, sizeof(*dd_ft_records));
+    if (!dd_ft_records) return NULL;
+    char path[512]; snprintf(path, sizeof(path), "%s/ready-%d-%s", dd_ft_root, (int)getpid(), dd_ft_role);
+    FILE *ready = fopen(path, "w");
+    if (ready) { fprintf(ready, "version=1 pid=%d role=%s\n", (int)getpid(), dd_ft_role); fclose(ready); }
+    while (!__atomic_load_n(&dd_ft_stop, __ATOMIC_ACQUIRE)) {
+        uint64_t now = dd_ft_now(CLOCK_MONOTONIC);
+        if (dd_ft_active() && now >= dd_ft_end) dd_ft_dump(1);
+        char armed[512]; snprintf(armed, sizeof(armed), "%s/armed", dd_ft_root);
+        if (access(armed, F_OK)) break;
+        if (!dd_ft_active()) {
+            uint64_t run = 0, start = 0, end = 0; unsigned stride = 0; char extra;
+            char control_path[512]; snprintf(control_path, sizeof(control_path), "%s/control", dd_ft_root);
+            FILE *control = fopen(control_path, "r");
+            int n = control ? fscanf(control, "%" SCNu64 " %" SCNu64 " %" SCNu64 " %u %c", &run, &start, &end, &stride, &extra) : 0;
+            if (control) fclose(control);
+            if (n == 4 && run && run != dd_ft_last_run && stride && stride <= 64 &&
+                    end > start && end-start <= UINT64_C(30000000000) && start <= now + UINT64_C(60000000000) && now < end) {
+                pthread_mutex_lock(&dd_ft_lock);
+                dd_ft_ready_ns = now; dd_ft_run = run; dd_ft_start = start; dd_ft_end = end; dd_ft_cpu_stride = stride; dd_ft_used = 0;
+                __atomic_store_n(&dd_ft_dropped, 0, __ATOMIC_RELAXED);
+                __atomic_store_n(&dd_ft_enabled, DD_FT_ON, __ATOMIC_RELEASE);
+                pthread_mutex_unlock(&dd_ft_lock);
+            }
+        }
+        struct timespec delay = {0, 100000000}; nanosleep(&delay, NULL);
+    }
+    if (dd_ft_active()) dd_ft_dump(dd_ft_now(CLOCK_MONOTONIC) >= dd_ft_end);
+    unlink(path); free(dd_ft_records); dd_ft_records = NULL;
+    return NULL;
+}
+void dd_ft_init(const char *role) {
+    /* Startup-only arm marker. No polling thread exists in default sessions. */
+    const char *root = getenv("DROIDDECK_FRAME_TRACE_DIR");
+    if (!root || !*root) root = DD_FT_ROOT;
+    if (!root || root[0] != '/' || strlen(root) >= sizeof(dd_ft_root)) return;
+    char armed[512]; snprintf(armed, sizeof(armed), "%s/armed", root);
+    if (access(armed, F_OK)) return;
+    unsigned expected = 0;
+    if (!__atomic_compare_exchange_n(&dd_ft_running, &expected, 1, 0, __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) return;
+    snprintf(dd_ft_root, sizeof(dd_ft_root), "%s", root);
+    dd_ft_role = role; __atomic_store_n(&dd_ft_stop, 0, __ATOMIC_RELEASE);
+    if (pthread_create(&dd_ft_thread, NULL, dd_ft_worker, NULL)) __atomic_store_n(&dd_ft_running, 0, __ATOMIC_RELEASE);
+}
+void dd_ft_shutdown(void) {
+    if (!__atomic_load_n(&dd_ft_running, __ATOMIC_ACQUIRE)) return;
+    __atomic_store_n(&dd_ft_stop, 1, __ATOMIC_RELEASE);
+    pthread_join(dd_ft_thread, NULL);
+    __atomic_store_n(&dd_ft_running, 0, __ATOMIC_RELEASE);
+}
diff --git a/src/mali_normal.cpp b/src/mali_normal.cpp
index 4cb8631..93223d7 100644
--- a/src/mali_normal.cpp
+++ b/src/mali_normal.cpp
@@ -1,8 +1,10 @@
 /* Experimental normal single-client session. Output is the actual CWaylandBackend,
  * input uses its existing seat listeners, SHM imports use Gamescope's renderer.
  * The application is an argv child, with no diagnostic frame limit/injection. */
 #include "mali_normal.hpp"
+#include "frame_trace.inc"
+dd_ft_id g_maliFrameTrace{};
 #include "normal_detail_perf.hpp"
 #include "backend.h"
 #include "backends.h"
 #include "rendervulkan.hpp"
@@ -48,9 +50,9 @@ struct Input { unsigned type; double x, y; uint32_t code, state; };
 static std::mutex inputLock;
 static std::deque<Input> inputs;
 struct Host {
     wl_display *display = nullptr; wl_surface *surface = nullptr; banner_ahb_v1 *manager = nullptr;
-    struct Buffer { wl_buffer *buffer = nullptr; unsigned index = 0; bool busy = false; } buffers[3];
+    struct Buffer { wl_buffer *buffer = nullptr; unsigned index = 0; bool busy = false; dd_ft_id trace{}; } buffers[3];
 } host;
 struct Server {
     wl_display *display = nullptr; wlr_renderer *renderer = nullptr; wlr_surface *surface = nullptr;
     wlr_seat *seat = nullptr; wlr_keyboard *keyboard = nullptr;
@@ -63,11 +65,37 @@ struct Server {
     wlr_output *x11Output = nullptr;
     wl_listener x11ReadyListener{}, x11Created{};
     unsigned commits = 0, frames = 0, motions = 0, buttons = 0, keys = 0;
 } server;
+// Diagnostic state only; never drives pending/mapping/render/pacing decisions.
+static uint64_t traceClientSequence, traceAttempt, tracePending, traceLastRendered;
+static uint64_t TraceCommit(wlr_surface *surface, uint64_t window, bool selected) {
+    dd_ft_id id{}; id.client = ++traceClientSequence;
+    dd_ft_event(DD_FT_COMMIT, id, window, uint64_t(surface && surface->mapped), selected, 0);
+    if (selected) {
+        if (server.pending && tracePending &&
+                (!g_maliFrameTrace.attempt || tracePending != g_maliFrameTrace.client)) {
+            dd_ft_id old{}; old.client = tracePending;
+            dd_ft_event(DD_FT_COALESCE, old, window, id.client, 0, 0);
+        }
+        tracePending = id.client;
+    }
+    return id.client;
+}
+static void TraceSelect(uint64_t client, uint64_t window) {
+    if (server.pending && tracePending &&
+            (!g_maliFrameTrace.attempt || tracePending != g_maliFrameTrace.client)) {
+        dd_ft_id old{}; old.client = tracePending;
+        dd_ft_event(DD_FT_DISCARD, old, window, client, 1, 0); // focus/surface replacement
+    }
+    tracePending = client;
+    dd_ft_id id{}; id.client = client;
+    dd_ft_event(DD_FT_SELECT, id, window, 0, client ? 0 : 1, 0); // zero = pre-capture/unknown commit
