+enum dd_perf_category {
+    DD_PERF_MEMORY, DD_PERF_RECORDING, DD_PERF_UPDATES, DD_PERF_SUBMIT,
+    DD_PERF_SYNC, DD_PERF_RESOURCES, DD_PERF_PRESENT, DD_PERF_OTHER,
