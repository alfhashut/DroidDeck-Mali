+    std::printf("MaliPerf wait coverage: opcode63=%llu attributed=%llu (missing attribution is not assumed satisfied; native off-CPU is an estimate, not GPU execution)\n",
+        (unsigned long long)(p.rpc.op[MB_RENDERER_WAIT].count + p.outside.op[MB_RENDERER_WAIT].count), (unsigned long long)attributed);
+    dd_perf_report_resources(stdout, &p.rpc, &p.outside, p.frames);
