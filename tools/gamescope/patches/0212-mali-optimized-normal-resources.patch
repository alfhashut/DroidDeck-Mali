+        (unsigned long long)p.rpc.op[MB_AHB_CREATE].count, (unsigned long long)p.rpc.op[MB_RENDERER_IDLE].count,
+        (unsigned long long)p.rpc.op[MB_SYNC_FENCE_CREATE].count,
+        (unsigned long long)(p.rpc.op[MB_IMAGE_CREATE].count + p.rpc.op[MB_RENDERER_IMAGE].count),
