+            maliLocalWaits.forwarded[i] / double(p.frames ? p.frames : 1));
+    }
+    auto &staging = maliStaging.stats;
+    std::printf("MaliPerf staging: hits=%llu misses=%llu reuse-waits=%llu resources-created=%llu resized=%llu failures=%llu live=%u limit=3 (buffer+memory pairs; window totals)\n",
+        (unsigned long long)staging.hits, (unsigned long long)staging.misses, (unsigned long long)staging.waits,
+        (unsigned long long)staging.created, (unsigned long long)staging.resized, (unsigned long long)staging.failures, maliStaging.live());
