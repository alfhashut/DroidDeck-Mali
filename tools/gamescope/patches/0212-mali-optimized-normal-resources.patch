+    std::printf("MaliPerf budget window: main-thread-CPU=%.3fms off-CPU=%.3fms RPC-sync-wait=%.3fms other-RPC=%.3fms host-non-RPC=%.3fms outside-frames=%.3fms output-backpressure=%.3fms pool-occupied-avg=%.2f/3 guest-Android-owned-avg/max=%.2f/%u native-owned-current=%u pending-GPU=%u open-FDs=%u top-RPC=%u:%.3fms,%u:%.3fms,%u:%.3fms (CPU/off-CPU partitions frame work and overlaps RPC buckets; off-CPU includes waits/scheduling/other processes; other-RPC includes native execution/transport/scheduling; outside includes client/pacing/events; backpressure overlaps outside)\n",
+        p.cpuNs / 1e6, (p.frameNs > p.cpuNs ? p.frameNs - p.cpuNs : 0) / 1e6,
+        syncWait / 1e6, (rpcNs - syncWait) / 1e6, nonRpc / 1e6, outsideFrames / 1e6,
+        p.outputWaitNs / 1e6, p.occupiedNs / window, p.androidNs / window, p.maxAndroid, stats.owned,
+        stats.counts[19], stats.counts[18], top[0], p.rpc.op[top[0]].ns / 1e6,
+        top[1], p.rpc.op[top[1]].ns / 1e6, top[2], p.rpc.op[top[2]].ns / 1e6);
+    maliCpuDetail.report(p.attempts, p.compositeNs / attempts / 1e6);
+    dd_perf_report_opcodes(stdout, &p.rpc, &p.outside, p.frames, p.attempts);
+    uint64_t attributed = 0;
+    for (unsigned i = 0; i < DD_WAIT_REASONS; ++i) {
+        dd_wait_report(stdout, i, &p.rpc.wait[i], &p.outside.wait[i], p.frames);
+        attributed += p.rpc.wait[i].count + p.outside.wait[i].count;
