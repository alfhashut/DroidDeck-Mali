+// Four independent checkpoint 4D diagnostics. No renderer, backend or session.
+#include "vulkan_interop_test.hpp"
+#include <vulkan/vulkan.h>
+#include "interop_test_api.h"
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+namespace {
+bool result(const char *stage, VkResult r) {
+    std::printf("%s: VkResult=%d%s\n", stage, r, r == VK_SUCCESS ? " VK_SUCCESS" : "");
+    std::fflush(stdout); return r == VK_SUCCESS;
+}
+struct Test {
+    VkInstance instance = VK_NULL_HANDLE;
+    VkDevice device = VK_NULL_HANDLE;
+    VkPhysicalDevice physical = VK_NULL_HANDLE;
+    VkQueue queue = VK_NULL_HANDLE;
+    uint32_t family = ~0u, token = 0, sync = 0;
+    VkPhysicalDeviceMemoryProperties types = {};
+    VkCommandPool pool = VK_NULL_HANDLE;
+    VkCommandBuffer command = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    VkImage image = VK_NULL_HANDLE;
+    std::vector<VkBuffer> buffers;
+    std::vector<VkDeviceMemory> memories;
+    PFN_vkDroidDeckInteropTEST interop = nullptr;
+    bool pending = false;
+    bool service(uint32_t op, dd_interop_input in, dd_interop_output &out, const char *name) {
+        return interop && result(name, interop(device, op, &in, &out));
+    }
+    void destroy() {
+        if (device) {
+            if (!pending) {
+                if (command) vkFreeCommandBuffers(device, pool, 1, &command);
+                if (pool) vkDestroyCommandPool(device, pool, nullptr);
+                if (fence) vkDestroyFence(device, fence, nullptr);
+                for (VkBuffer b : buffers) vkDestroyBuffer(device, b, nullptr);
+                if (image) vkDestroyImage(device, image, nullptr);
+                for (VkDeviceMemory m : memories) vkFreeMemory(device, m, nullptr);
+                dd_interop_output out = {};
+                if (token) service(DD_AHB_RELEASE, {.token = token}, out, "broker AHB reference released");
+                if (sync) service(DD_SYNC_CLOSE, {.sync = sync}, out, "broker SYNC_FD closed");
+            } else std::puts("pending producer: broker device teardown drains work before child cleanup");
+            vkDestroyDevice(device, nullptr); device = VK_NULL_HANDLE;
+        }
+        if (instance) { vkDestroyInstance(instance, nullptr); instance = VK_NULL_HANDLE; }
+        std::puts("full device/instance cleanup");
+    }
+    ~Test() { if (instance || device) destroy(); }
+    bool initialize(bool external) {
+        std::puts("normal Gamescope requirements unchanged; diagnostic exits before renderer/backend startup");
+        VkApplicationInfo app = {.sType = VK_STRUCTURE_TYPE_APPLICATION_INFO, .pApplicationName = "Gamescope memory interop test", .apiVersion = VK_API_VERSION_1_0};
+        VkInstanceCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO, .pApplicationInfo = &app};
+        if (!result("vkCreateInstance", vkCreateInstance(&ci, nullptr, &instance))) return false;
+        uint32_t n = 0;
+        if (!result("enumeration count", vkEnumeratePhysicalDevices(instance, &n, nullptr)) || !n || n > 16) return false;
+        std::vector<VkPhysicalDevice> devices(n);
+        if (!result("enumeration", vkEnumeratePhysicalDevices(instance, &n, devices.data()))) return false;
+        for (VkPhysicalDevice p : devices) {
+            VkPhysicalDeviceProperties props = {}; vkGetPhysicalDeviceProperties(p, &props);
+            if (props.vendorID == 0x13b5 && props.deviceID == 0x74021000) {
+                physical = p;
+                std::printf("real Mali: %s physical API=%u.%u.%u\n", props.deviceName, VK_VERSION_MAJOR(props.apiVersion), VK_VERSION_MINOR(props.apiVersion), VK_VERSION_PATCH(props.apiVersion)); break;
+            }
+        }
+        if (!physical) return false;
+        vkGetPhysicalDeviceMemoryProperties(physical, &types);
+        vkGetPhysicalDeviceQueueFamilyProperties(physical, &n, nullptr);
+        if (!n || n > 64) return false;
+        std::vector<VkQueueFamilyProperties> families(n); vkGetPhysicalDeviceQueueFamilyProperties(physical, &n, families.data());
+        for (uint32_t i = 0; i < n; ++i) if (families[i].queueCount && (families[i].queueFlags & (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) == (VK_QUEUE_GRAPHICS_BIT | VK_QUEUE_COMPUTE_BIT)) { family = i; break; }
+        if (family == ~0u) return false;
+        float priority = 1.0f;
+        VkDeviceQueueCreateInfo q = {.sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, .queueFamilyIndex = family, .queueCount = 1, .pQueuePriorities = &priority};
+        VkPhysicalDeviceFeatures disabled = {};
+        VkDeviceCreateInfo d = {.sType = VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO, .queueCreateInfoCount = 1, .pQueueCreateInfos = &q, .pEnabledFeatures = &disabled};
+        if (!result("vkCreateDevice", vkCreateDevice(physical, &d, nullptr, &device))) return false;
+        std::printf("real queue family=%u; guest extensions/features=none\n", family);
+        vkGetDeviceQueue(device, family, 0, &queue); if (!queue) return false;
+        if (external) {
+            interop = reinterpret_cast<PFN_vkDroidDeckInteropTEST>(vkGetDeviceProcAddr(device, "vkDroidDeckInteropTEST"));
+            if (!interop) { std::puts("private broker AHB diagnostic service unavailable"); return false; }
+        }
+        VkCommandPoolCreateInfo p = {.sType = VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO, .queueFamilyIndex = family};
+        if (!result("vkCreateCommandPool", vkCreateCommandPool(device, &p, nullptr, &pool))) return false;
+        VkCommandBufferAllocateInfo a = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO, .commandPool = pool, .level = VK_COMMAND_BUFFER_LEVEL_PRIMARY, .commandBufferCount = 1};
+        return result("vkAllocateCommandBuffers", vkAllocateCommandBuffers(device, &a, &command));
+    }
+    bool allocate(VkMemoryRequirements req, VkMemoryPropertyFlags required, VkMemoryPropertyFlags preferred, VkDeviceMemory &out, bool &coherent) {
+        if (!req.size || !req.alignment || !req.memoryTypeBits) return false;
+        uint32_t type = ~0u;
+        for (unsigned pass = 0; pass < 2 && type == ~0u; ++pass) for (uint32_t i = 0; i < types.memoryTypeCount; ++i) {
+            VkMemoryPropertyFlags flags = types.memoryTypes[i].propertyFlags;
+            if ((req.memoryTypeBits & (1u << i)) && (flags & required) == required && (pass || (flags & preferred) == preferred)) { type = i; break; }
+        }
+        if (type == ~0u) { std::puts("no compatible real memory type"); return false; }
+        coherent = (types.memoryTypes[type].propertyFlags & VK_MEMORY_PROPERTY_HOST_COHERENT_BIT) != 0;
+        std::printf("real requirements size=%llu alignment=%llu typeBits=0x%x; selected memory type=%u coherent=%u\n", (unsigned long long)req.size, (unsigned long long)req.alignment, req.memoryTypeBits, type, coherent);
+        VkMemoryAllocateInfo ai = {.sType = VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO, .allocationSize = req.size, .memoryTypeIndex = type};
+        if (!result("vkAllocateMemory", vkAllocateMemory(device, &ai, nullptr, &out))) return false;
+        memories.push_back(out); return true;
+    }
+    bool buffer(uint64_t size, VkBuffer &b, VkDeviceMemory &m, bool &coherent) {
+        VkBufferCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO, .size = size, .usage = VK_BUFFER_USAGE_TRANSFER_SRC_BIT | VK_BUFFER_USAGE_TRANSFER_DST_BIT, .sharingMode = VK_SHARING_MODE_EXCLUSIVE};
+        if (!result("vkCreateBuffer", vkCreateBuffer(device, &ci, nullptr, &b))) return false;
+        buffers.push_back(b); VkMemoryRequirements req = {}; vkGetBufferMemoryRequirements(device, b, &req);
+        return allocate(req, VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT, VK_MEMORY_PROPERTY_HOST_COHERENT_BIT, m, coherent) && result("vkBindBufferMemory", vkBindBufferMemory(device, b, m, 0));
+    }
+    bool begin() {
+        VkCommandBufferBeginInfo bi = {.sType = VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+        return result("vkBeginCommandBuffer", vkBeginCommandBuffer(command, &bi));
+    }
+    bool submit(bool external) {
+        if (!result("vkEndCommandBuffer", vkEndCommandBuffer(command))) return false;
+        if (external) {
+            dd_interop_output out = {};
+            if (!service(DD_FENCE_CREATE, {}, out, "exportable binary SYNC_FD fence created")) return false;
+            fence = out.fence;
+        } else {
+            VkFenceCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+            if (!result("vkCreateFence", vkCreateFence(device, &ci, nullptr, &fence))) return false;
+        }
+        VkSubmitInfo si = {.sType = VK_STRUCTURE_TYPE_SUBMIT_INFO, .commandBufferCount = 1, .pCommandBuffers = &command};
+        if (!result("vkQueueSubmit", vkQueueSubmit(queue, 1, &si, fence))) return false;
+        pending = true;
+        if (external) {
+            dd_interop_output out = {};
+            if (!service(DD_SYNC_EXPORT, {.fence = fence}, out, "native vkGetFenceFdKHR SYNC_FD (0x8) exported to broker token")) return false;
+            sync = out.sync;
+            // SYNC_FD copy export resets fence payload; wait the FD, never that fence.
+            if (!service(DD_SYNC_WAIT, {.sync = sync}, out, "producer SYNC_FD signaled")) return false;
+        } else if (!result("vkWaitForFences", vkWaitForFences(device, 1, &fence, VK_TRUE, 5000000000ull))) return false;
+        pending = false; return true;
+    }
+    void host_barrier(VkBuffer b) {
+        VkBufferMemoryBarrier barrier = {.sType = VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER, .srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT, .dstAccessMask = VK_ACCESS_HOST_READ_BIT,
+            .srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED, .buffer = b, .size = VK_WHOLE_SIZE};
+        vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT, VK_PIPELINE_STAGE_HOST_BIT, 0, 0, nullptr, 1, &barrier, 0, nullptr);
+    }
+    void image_barrier(VkImageLayout old, VkImageLayout next, bool release = false) {
+        bool acquire = token && old == VK_IMAGE_LAYOUT_UNDEFINED;
+        VkPipelineStageFlags src = old == VK_IMAGE_LAYOUT_UNDEFINED ? VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT : VK_PIPELINE_STAGE_TRANSFER_BIT;
+        VkPipelineStageFlags dst = release ? VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT : VK_PIPELINE_STAGE_TRANSFER_BIT;
+        VkAccessFlags sa = old == VK_IMAGE_LAYOUT_UNDEFINED ? 0 : old == VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL ? VK_ACCESS_TRANSFER_WRITE_BIT : VK_ACCESS_TRANSFER_READ_BIT;
+        VkAccessFlags da = release ? 0 : next == VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL ? VK_ACCESS_TRANSFER_WRITE_BIT : VK_ACCESS_TRANSFER_READ_BIT;
+        VkImageMemoryBarrier b = {.sType = VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER, .srcAccessMask = sa, .dstAccessMask = da, .oldLayout = old, .newLayout = next,
+            .srcQueueFamilyIndex = release ? family : acquire ? VK_QUEUE_FAMILY_FOREIGN_EXT : VK_QUEUE_FAMILY_IGNORED, .dstQueueFamilyIndex = release ? VK_QUEUE_FAMILY_FOREIGN_EXT : acquire ? family : VK_QUEUE_FAMILY_IGNORED,
+            .image = image, .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1}};
+        vkCmdPipelineBarrier(command, src, dst, 0, 0, nullptr, 0, nullptr, 1, &b);
+    }
+    bool invalidate(VkDeviceMemory memory, bool coherent) {
+        if (coherent) return true;
+        VkMappedMemoryRange r = {.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, .memory = memory, .size = VK_WHOLE_SIZE};
+        return result("vkInvalidateMappedMemoryRanges", vkInvalidateMappedMemoryRanges(device, 1, &r));
+    }
+    bool flush(VkDeviceMemory memory, bool coherent) {
+        if (coherent) return true;
+        VkMappedMemoryRange r = {.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE, .memory = memory, .size = VK_WHOLE_SIZE};
+        return result("vkFlushMappedMemoryRanges", vkFlushMappedMemoryRanges(device, 1, &r));
+    }
+};
+void pixel(uint8_t *p, uint32_t x, uint32_t y, uint32_t size, bool quadrants) {
+    const uint8_t color[4] = {64, 128, 191, 255};
+    if (!quadrants) { std::memcpy(p, color, 4); return; }
+    p[0] = p[1] = p[2] = 0; p[3] = 255;
+    if (y < size / 2) p[x < size / 2 ? 0 : 1] = 255;
+    else if (x < size / 2) p[2] = 255; else p[0] = p[1] = p[2] = 255;
+}
+// Common image/readback mechanics; each public diagnostic constructs its own instance/device.
+bool image_work(Test &t, uint32_t size, bool ahb, bool quadrants) {
+    bool coherent = false;
+    if (ahb) {
+        dd_interop_output out = {};
+        if (!t.service(DD_AHB_CREATE, {.width = size, .height = size}, out, "dedicated real AHB image imported")) return false;
+        t.image = out.image; t.memories.push_back(out.memory); t.token = out.token;
+        std::printf("Android AHB describe: width=%u height=%u format=%u layers=%u usage=0x%llx token=%u\n", out.width, out.height, out.format, out.layers, (unsigned long long)out.usage, out.token);
+        if (out.width != size || out.height != size || out.format != 1 || out.layers != 1) return false;
+    } else {
+        VkImageCreateInfo ci = {.sType = VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO, .imageType = VK_IMAGE_TYPE_2D, .format = VK_FORMAT_R8G8B8A8_UNORM,
+            .extent = {size, size, 1}, .mipLevels = 1, .arrayLayers = 1, .samples = VK_SAMPLE_COUNT_1_BIT, .tiling = VK_IMAGE_TILING_OPTIMAL,
+            .usage = VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT, .sharingMode = VK_SHARING_MODE_EXCLUSIVE, .initialLayout = VK_IMAGE_LAYOUT_UNDEFINED};
+        if (!result("vkCreateImage RGBA8 optimal", vkCreateImage(t.device, &ci, nullptr, &t.image))) return false;
+        VkMemoryRequirements req = {}; vkGetImageMemoryRequirements(t.device, t.image, &req); VkDeviceMemory m = VK_NULL_HANDLE;
+        if (!t.allocate(req, 0, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, m, coherent) || !result("vkBindImageMemory", vkBindImageMemory(t.device, t.image, m, 0))) return false;
+    }
+    VkBuffer staging = VK_NULL_HANDLE; VkDeviceMemory memory = VK_NULL_HANDLE;
+    if (!t.buffer(uint64_t(size) * size * 4, staging, memory, coherent)) return false;
+    if (quadrants) {
+        void *ptr = nullptr; if (!result("vkMapMemory upload", vkMapMemory(t.device, memory, 0, VK_WHOLE_SIZE, 0, &ptr))) return false;
+        for (uint32_t y = 0; y < size; ++y) for (uint32_t x = 0; x < size; ++x) pixel(static_cast<uint8_t *>(ptr) + (uint64_t(y) * size + x) * 4, x, y, size, true);
+        bool ok = t.flush(memory, coherent); vkUnmapMemory(t.device, memory); if (!ok) return false;
+    }
+    if (!t.begin()) return false;
+    t.image_barrier(VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkBufferImageCopy copy = {.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 0, 1}, .imageExtent = {size, size, 1}};
+    if (quadrants) {
+        vkCmdCopyBufferToImage(t.command, staging, t.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &copy);
+        std::puts("Mali Vulkan copies deterministic RGBA quadrants into actual AHB image");
+    } else {
+        VkClearColorValue color = {{0.25f, 0.5f, 0.75f, 1.0f}};
+        VkImageSubresourceRange range = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+        vkCmdClearColorImage(t.command, t.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &color, 1, &range);
+    }
+    t.image_barrier(VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    vkCmdCopyImageToBuffer(t.command, t.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, staging, 1, &copy);
+    t.host_barrier(staging);
+    if (ahb) t.image_barrier(VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, VK_IMAGE_LAYOUT_GENERAL, true);
+    if (!t.submit(ahb)) return false;
+    void *ptr = nullptr; if (!result("vkMapMemory readback", vkMapMemory(t.device, memory, 0, VK_WHOLE_SIZE, 0, &ptr))) return false;
+    bool ok = t.invalidate(memory, coherent); uint64_t bad = 0;
+    if (ok) for (uint32_t y = 0; y < size; ++y) for (uint32_t x = 0; x < size; ++x) {
+        uint8_t expected[4]; pixel(expected, x, y, size, quadrants);
+        if (std::memcmp(static_cast<uint8_t *>(ptr) + (uint64_t(y) * size + x) * 4, expected, 4)) ++bad;
+    }
+    vkUnmapMemory(t.device, memory);
+    std::printf("actual %s image GPU readback: mismatched pixels=%llu; RGBA order verified\n", ahb ? "AHB-backed" : "RGBA8", (unsigned long long)bad);
+    if (!ok || bad) return false;
+    if (ahb) {
+        dd_interop_output out = {};
+        if (!t.service(DD_AHB_INSPECT, {.token = t.token, .sync = t.sync, .pattern = quadrants ? 1u : 0u}, out, "Android AHB inspection after producer completion")) return false;
+        std::puts(out.cpu_checked ? "AHB CPU lock and actual pixel verification: PASS" : "AHB CPU lock unavailable for actual usage; same-image GPU readback verified");
+    }
+    return true;
+}
+}
+int vulkan_buffer_memory_test() {
+    std::puts("4D1 Vulkan buffer memory test"); Test t; if (!t.initialize(false)) return 1;
+    VkBuffer b = VK_NULL_HANDLE; VkDeviceMemory m = VK_NULL_HANDLE; bool coherent = false;
+    if (!t.buffer(4096, b, m, coherent)) return 1;
+    void *ptr = nullptr; if (!result("vkMapMemory initialize", vkMapMemory(t.device, m, 0, VK_WHOLE_SIZE, 0, &ptr))) return 1;
+    std::memset(ptr, 0, 4096); bool ok = t.flush(m, coherent); vkUnmapMemory(t.device, m); if (!ok || !t.begin()) return 1;
+    vkCmdFillBuffer(t.command, b, 0, 4096, 0x12345678); t.host_barrier(b);
