From: DroidDeck
Subject: [PATCH] main: opt-in Vulkan capability inspection without a logical device

diff --git a/src/main.cpp b/src/main.cpp
index ba42b00..aa0c29c 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -26,6 +26,7 @@
 #include "steamcompmgr.hpp"
 #include "rendervulkan.hpp"
 #include "vulkan_enumerate_only.hpp"
+#include "vulkan_capabilities.hpp"
 #include "wlserver.hpp"
 #include "convar.h"
 #include "gpuvis_trace_utils.h"
@@ -62,6 +63,7 @@ const struct option *gamescope_options = (struct option[]){
 	{ "help", no_argument, nullptr, 0 },
 	{ "version", no_argument, nullptr, 0 },
 	{ "vk-enumerate-only", no_argument, nullptr, 0 },
+	{ "vk-capabilities", no_argument, nullptr, 0 },
 	{ "nested-width", required_argument, nullptr, 'w' },
 	{ "nested-height", required_argument, nullptr, 'h' },
 	{ "nested-refresh", required_argument, nullptr, 'r' },
@@ -172,6 +174,7 @@ const char usage[] =
 	"Options:\n"
 	"  --help                         show help message\n"
 	"  --vk-enumerate-only            print Vulkan devices and exit without initializing a renderer/backend\n"
+	"  --vk-capabilities              print Vulkan capabilities without initializing a renderer/backend\n"
 	"  -W, --output-width             output width\n"
 	"  -H, --output-height            output height\n"
 	"  -w, --nested-width             game width\n"
@@ -720,6 +723,8 @@ int main(int argc, char **argv)
 	// The standalone diagnostic exits before any normal startup, including scripts/X11.
 	if ( argc == 2 && strcmp( argv[1], "--vk-enumerate-only" ) == 0 )
 		return vulkan_enumerate_only();
+	if ( argc == 2 && strcmp( argv[1], "--vk-capabilities" ) == 0 )
+		return vulkan_capabilities();
 
 	g_argc = argc;
 	g_argv = argv;
@@ -798,6 +803,8 @@ int main(int argc, char **argv)
 					return 0;
 				} else if (strcmp(opt_name, "vk-enumerate-only") == 0) {
 					return vulkan_enumerate_only();
+				} else if (strcmp(opt_name, "vk-capabilities") == 0) {
+					return vulkan_capabilities();
 				} else if (strcmp(opt_name, "version") == 0) {
 					gamescope::PrintVersion();
 					return 0;
diff --git a/src/meson.build b/src/meson.build
index 707570b..115c5de 100644
--- a/src/meson.build
