+    for (const auto &point : points) { const uint8_t *p = (const uint8_t *)mapped + (point[1] * 256 + point[0]) * 4; std::printf("final AHB GPU readback pixel(%u,%u) RGBA=(%u,%u,%u,%u)\n", point[0], point[1], p[0], p[1], p[2], p[3]); }
+    g_device.vk.UnmapMemory(g_device.device(), readbackMemory);
+    std::printf("actual final AHB readback: mismatches=%u source-vs-final differing pixels=%u\n", bad, different);
+    require(!bad && different == 49152, "Gamescope transformed pixel verification");
+    input = {}; input.token = ahb.token; input.sync = sync; input.pattern = 2;
+    require(call(DD_AHB_INSPECT, input, output, "exact final AHB CPU inspection (when lockable)"), "AHB actual bytes");
+    std::printf("AHB CPU inspection checked=%u; actual same-image GPU readback checked=1\n", output.cpu_checked);
