+    r = vk.EnumerateDeviceExtensionProperties(physDev(), nullptr, &n, m_supportedExts.data());
+    if (r != VK_SUCCESS) { vk_errorf(r, "vkEnumerateDeviceExtensionProperties list"); return false; }
+    const char *extensions[] = {"VK_KHR_timeline_semaphore", "VK_EXT_scalar_block_layout", "VK_KHR_image_format_list"};
+    for (const char *required : extensions) {
+        bool found = false;
