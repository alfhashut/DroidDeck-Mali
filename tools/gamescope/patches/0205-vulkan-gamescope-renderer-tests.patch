+}
+
+bool CVulkanDevice::CreateMaliDiagnosticDummies()
+{
+    const VkImageType types[] = {VK_IMAGE_TYPE_2D, VK_IMAGE_TYPE_1D, VK_IMAGE_TYPE_3D, VK_IMAGE_TYPE_2D};
+    for (uint32_t i = 0; i < 4; ++i) {
+        CVulkanTexture::createFlags flags; flags.imageType = types[i]; flags.bSampled = i < 3; flags.bStorage = i == 3; flags.bTransferDst = true;
+        m_maliDummies[i] = new CVulkanTexture();
+        if (!m_maliDummies[i]->BInit(1, 1, 1, DRM_FORMAT_ABGR8888, flags)) return false;
+    }
+    auto command = commandBuffer(); if (!command) return false;
+    const VkClearColorValue zero{};
+    const VkImageSubresourceRange range{VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1};
+    for (auto &texture : m_maliDummies) {
+        command->discardImage(texture.get()); command->insertBarrier();
+        vk.CmdClearColorImage(command->rawBuffer(), texture->vkImage(), VK_IMAGE_LAYOUT_GENERAL, &zero, 1, &range);
+        command->markDirty(texture.get());
+    }
+    submit(std::move(command)); waitIdle();
+    std::puts("null descriptors replaced with valid dummy resources: transparent sampled 2D/1D/3D and separate zero storage 2D, initialized on GPU, GENERAL layout");
+    return true;
+}
+
+bool CVulkanTexture::BInitMaliAHB(VkImage image, uint32_t width, uint32_t height)
+{
+    if (!g_device.IsMaliDiagnostic() || !image) return false;
+    m_vkImage = image; // private AHB helper owns the image and imported allocation
+    m_width = m_contentWidth = width; m_height = m_contentHeight = height; m_depth = 1;
+    m_drmFormat = DRM_FORMAT_ABGR8888; m_format = VK_FORMAT_R8G8B8A8_UNORM;
+    m_bExternal = true; m_maliStorageImage = true; m_bOutputImage = false;
+    VkImageViewCreateInfo ci = { .sType = VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO, .image = image, .viewType = VK_IMAGE_VIEW_TYPE_2D, .format = m_format, .subresourceRange = {VK_IMAGE_ASPECT_COLOR_BIT, 0, 1, 0, 1} };
+    VkResult r = g_device.vk.CreateImageView(g_device.device(), &ci, nullptr, &m_srgbView);
+    if (r != VK_SUCCESS) { vk_errorf(r, "vkCreateImageView AHB storage target"); return false; }
+    m_bInitialized = true; return true;
+}
+
+void CVulkanDevice::ShutdownMaliDiagnostic()
+{
+    if (!m_maliDiagnostic) return;
+    if (m_device) {
+        auto idle = (PFN_vkDeviceWaitIdle)vk.GetDeviceProcAddr(device(), "vkDeviceWaitIdle");
+        if (idle) { VkResult r = idle(device()); if (r != VK_SUCCESS) FailMaliDiagnostic("vkDeviceWaitIdle cleanup", r); }
+        m_pendingCmdBufs.clear(); m_unusedCmdBufs.clear();
+        for (auto &texture : m_maliDummies) texture = nullptr;
+        for (auto &[key, pipeline] : m_pipelineMap) if (pipeline) vk.DestroyPipeline(device(), pipeline, nullptr);
+        m_pipelineMap.clear();
+        auto destroyShader = (PFN_vkDestroyShaderModule)vk.GetDeviceProcAddr(device(), "vkDestroyShaderModule");
+        for (auto &shader : m_shaderModules) if (shader && destroyShader) { destroyShader(device(), shader, nullptr); shader = VK_NULL_HANDLE; }
+        if (m_descriptorPool) vk.DestroyDescriptorPool(device(), m_descriptorPool, nullptr);
+        if (m_pipelineLayout) vk.DestroyPipelineLayout(device(), m_pipelineLayout, nullptr);
+        if (m_descriptorSetLayout) vk.DestroyDescriptorSetLayout(device(), m_descriptorSetLayout, nullptr);
+        for (auto &[key, samplerHandle] : m_samplerCache) if (samplerHandle) vk.DestroySampler(device(), samplerHandle, nullptr);
+        m_samplerCache.clear();
+        if (m_scratchTimelineSemaphore) vk.DestroySemaphore(device(), m_scratchTimelineSemaphore, nullptr);
+        if (m_uploadBufferData) vk.UnmapMemory(device(), m_uploadBufferMemory);
+        m_uploadBufferData = nullptr;
+        if (m_uploadBuffer) vk.DestroyBuffer(device(), m_uploadBuffer, nullptr);
+        if (m_uploadBufferMemory) vk.FreeMemory(device(), m_uploadBufferMemory, nullptr);
+        auto destroyPool = (PFN_vkDestroyCommandPool)vk.GetDeviceProcAddr(device(), "vkDestroyCommandPool");
+        if (m_commandPool && destroyPool) destroyPool(device(), m_commandPool, nullptr);
+        if (m_generalCommandPool && destroyPool) destroyPool(device(), m_generalCommandPool, nullptr);
+        if (idle) { VkResult r = idle(device()); if (r != VK_SUCCESS) FailMaliDiagnostic("vkDeviceWaitIdle final teardown", r); }
+        auto destroy = (PFN_vkDestroyDevice)vk.GetDeviceProcAddr(device(), "vkDestroyDevice");
+        if (destroy) destroy(device(), nullptr);
+        m_device = VK_NULL_HANDLE;
+    }
+    if (m_instance) {
+        auto destroy = (PFN_vkDestroyInstance)g_pfn_vkGetInstanceProcAddr(m_instance, "vkDestroyInstance");
+        if (destroy) destroy(m_instance, nullptr);
+        m_instance = VK_NULL_HANDLE;
+    }
+    std::puts("clean renderer teardown");
+}
+
+[[noreturn]] void CVulkanDevice::FailMaliDiagnostic(const char *operation, VkResult result)
+{
+    std::fprintf(stderr, "gamescope: renderer FAILED: last Vulkan operation=%s VkResult=%d\n", operation, int(result));
+    // Some failures occur inside a recording method: local C++ owners cannot be
+    // unwound with Gamescope's -fno-exceptions. Destroy the broker-owned device
+    // synchronously; it drains pending work and destroys every native child safely.
+    if (m_device) {
+        auto destroy = (PFN_vkDestroyDevice)vk.GetDeviceProcAddr(device(), "vkDestroyDevice");
+        if (destroy) destroy(device(), nullptr);
+    }
+    if (m_instance) {
+        auto destroy = (PFN_vkDestroyInstance)g_pfn_vkGetInstanceProcAddr(m_instance, "vkDestroyInstance");
+        if (destroy) destroy(m_instance, nullptr);
+    }
+    std::puts("failure cleanup: native device/children drained and destroyed; no PASS");
+    std::fflush(nullptr); _Exit(1);
+}
+
+static bool MaliResult(VkResult result, const char *operation)
+{
+    s_maliLastResult = result; s_maliLastOperation[0] = 0;
+    if (result != VK_SUCCESS) { vk_errorf(result, "%s", operation); return false; }
+    return true;
+}
