+    g_device.vk.DestroyBuffer(g_device.device(), readback, nullptr); g_device.vk.FreeMemory(g_device.device(), readbackMemory, nullptr);
+    g_device.vk.DestroyImage(g_device.device(), ahb.image, nullptr); g_device.vk.FreeMemory(g_device.device(), ahb.memory, nullptr);
+    require(call(DD_AHB_RELEASE, input, output, "AHB release"), "AHB release");
+    input = {}; input.sync = sync; require(call(DD_SYNC_CLOSE, input, output, "SYNC_FD close"), "sync close");
+    auto destroyFence = (PFN_vkDestroyFence)g_device.vk.GetDeviceProcAddr(g_device.device(), "vkDestroyFence"); destroyFence(g_device.device(), producer.fence, nullptr);
+    g_device.ShutdownMaliDiagnostic();
+    std::puts("Gamescope first frame PASS: actual BLIT compute output, exact AHB, native timeline + SYNC_FD, Android release, zero mismatches");
+    return 0;
+}
