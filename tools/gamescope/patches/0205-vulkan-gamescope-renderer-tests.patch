+    vk.GetPhysicalDeviceMemoryProperties(physDev(), &m_memoryProperties);
+    m_bSupportsFp16 = false; m_bSupportsModifiers = false;
+    m_generalQueueFamily = m_queueFamily;
+    float priority = 1.0f;
+    VkDeviceQueueCreateInfo queue = { .sType = VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO, .queueFamilyIndex = m_queueFamily, .queueCount = 1, .pQueuePriorities = &priority };
