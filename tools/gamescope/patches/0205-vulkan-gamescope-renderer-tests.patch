+        if (!found) { vk_errorf(VK_ERROR_EXTENSION_NOT_PRESENT, "required capability %s", required); return false; }
+    }
+    VkPhysicalDeviceScalarBlockLayoutFeaturesEXT scalar = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_SCALAR_BLOCK_LAYOUT_FEATURES_EXT };
+    VkPhysicalDeviceTimelineSemaphoreFeaturesKHR timeline = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_TIMELINE_SEMAPHORE_FEATURES_KHR, .pNext = &scalar };
+    VkPhysicalDeviceFeatures2 query = { .sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_FEATURES_2, .pNext = &timeline };
+    vk.GetPhysicalDeviceFeatures2(physDev(), &query);
+    if (!timeline.timelineSemaphore || !scalar.scalarBlockLayout) { vk_errorf(VK_ERROR_FEATURE_NOT_PRESENT, "required timelineSemaphore/scalarBlockLayout"); return false; }
+    VkPhysicalDeviceProperties props{}; vk.GetPhysicalDeviceProperties(physDev(), &props);
+#define MALI_LIMIT(field, required) do { if (props.limits.field < (required)) { vk_errorf(VK_ERROR_FEATURE_NOT_PRESENT, "required limit " #field " native=%llu required=%llu", (unsigned long long)props.limits.field, (unsigned long long)(required)); return false; } } while (0)
+    MALI_LIMIT(maxBoundDescriptorSets, 1u);
+    MALI_LIMIT(maxPerStageDescriptorSamplers, 36u); MALI_LIMIT(maxPerStageDescriptorSampledImages, 36u);
+    MALI_LIMIT(maxDescriptorSetSamplers, 36u); MALI_LIMIT(maxDescriptorSetSampledImages, 36u);
+    MALI_LIMIT(maxPerStageDescriptorStorageImages, 2u); MALI_LIMIT(maxDescriptorSetStorageImages, 2u);
+    MALI_LIMIT(maxPerStageDescriptorUniformBuffers, 1u); MALI_LIMIT(maxDescriptorSetUniformBuffers, 1u);
+    MALI_LIMIT(maxPerStageResources, 39u); MALI_LIMIT(maxUniformBufferRange, sizeof(BlitPushData_t));
+    MALI_LIMIT(maxImageDimension1D, 1u); MALI_LIMIT(maxImageDimension2D, 256u); MALI_LIMIT(maxImageDimension3D, 1u);
+    MALI_LIMIT(maxComputeWorkGroupInvocations, 64u);
+    MALI_LIMIT(maxComputeWorkGroupSize[0], 8u); MALI_LIMIT(maxComputeWorkGroupSize[1], 8u); MALI_LIMIT(maxComputeWorkGroupSize[2], 1u);
+    MALI_LIMIT(maxComputeWorkGroupCount[0], 32u); MALI_LIMIT(maxComputeWorkGroupCount[1], 32u); MALI_LIMIT(maxComputeWorkGroupCount[2], 1u);
+#undef MALI_LIMIT
+    std::printf("native descriptor limits verified: per-stage samplers=%u sampled images=%u; require 36 each, 2 storage images, 1 UBO; compute 8x8 supported\n", props.limits.maxPerStageDescriptorSamplers, props.limits.maxPerStageDescriptorSampledImages);
+    m_uVendorID = props.vendorID;
