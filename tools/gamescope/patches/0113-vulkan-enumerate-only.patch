diff --git a/src/vulkan_enumerate_only.cpp b/src/vulkan_enumerate_only.cpp
new file mode 100644
--- /dev/null
+++ b/src/vulkan_enumerate_only.cpp
@@ -0,0 +1,84 @@
+// Opt-in instance queries through the normal glibc Vulkan loader, independent of rendervulkan.
+#include "vulkan_enumerate_only.hpp"
+
+#include <stdio.h>
+#include <stdlib.h>
+#include <vulkan/vulkan.h>
+
+int vulkan_enumerate_only()
+{
+    // The query path works with a 1.0 ICD. Report the physical device's own version below.
+    const VkApplicationInfo app = {
+        .sType = VK_STRUCTURE_TYPE_APPLICATION_INFO,
+        .pApplicationName = "Gamescope Vulkan enumeration diagnostic",
+        .apiVersion = VK_API_VERSION_1_0,
+    };
+    const VkInstanceCreateInfo info = {
+        .sType = VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO,
+        .pApplicationInfo = &app,
+    };
+    VkInstance instance = VK_NULL_HANDLE;
+    printf("gamescope: Vulkan enumeration-only (instance API 1.0, no extensions)\n");
+    VkResult result = vkCreateInstance(&info, nullptr, &instance);
+    if (result != VK_SUCCESS)
+    {
+        fprintf(stderr, "gamescope: enumeration-only vkCreateInstance failed: %d\n", int(result));
+        return 1;
+    }
+    printf("gamescope: enumeration-only vkCreateInstance = VK_SUCCESS\n");
+
+    int code = 1;
+    VkPhysicalDevice *devices = nullptr;
+    uint32_t count = 0;
+    // Count/list can race hotplug. Retry VK_INCOMPLETE without publishing partial output.
+    for (unsigned attempt = 0; attempt < 4; ++attempt)
+    {
+        count = 0;
+        result = vkEnumeratePhysicalDevices(instance, &count, nullptr);
+        if (result != VK_SUCCESS)
+            break;
+        if (!count)
+        {
+            code = 0;
+            break;
+        }
+        devices = static_cast<VkPhysicalDevice *>(calloc(count, sizeof(*devices)));
+        if (!devices)
+        {
+            result = VK_ERROR_OUT_OF_HOST_MEMORY;
+            break;
+        }
+        result = vkEnumeratePhysicalDevices(instance, &count, devices);
+        if (result == VK_SUCCESS)
+        {
+            code = 0;
+            break;
+        }
+        free(devices);
+        devices = nullptr;
+        if (result != VK_INCOMPLETE)
+            break;
+    }
+
+    if (code == 0)
+    {
+        printf("gamescope: physical-device count = %u\n", count);
+        for (uint32_t i = 0; i < count; ++i)
+        {
+            VkPhysicalDeviceProperties p = {};
+            vkGetPhysicalDeviceProperties(devices[i], &p);
+            printf("Device %u\ndeviceName: %s\nvendorID: 0x%08x\ndeviceID: 0x%08x\n"
+                        "apiVersion: %u.%u.%u\ndriverVersion: %u\ndeviceType: %u\n",
+                        i, p.deviceName, p.vendorID, p.deviceID,
+                        VK_VERSION_MAJOR(p.apiVersion), VK_VERSION_MINOR(p.apiVersion),
+                        VK_VERSION_PATCH(p.apiVersion), p.driverVersion, unsigned(p.deviceType));
+        }
+    }
+    else
+        fprintf(stderr, "gamescope: enumeration-only physical-device query failed: %d\n", int(result));
+
+    free(devices);
+    vkDestroyInstance(instance, nullptr);
+    printf("gamescope: destroyed enumeration-only Vulkan instance\n");
+    return code;
+}
