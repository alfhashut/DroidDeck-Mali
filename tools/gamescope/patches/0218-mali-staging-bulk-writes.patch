diff --git a/src/interop_protocol.h b/src/interop_protocol.h
index fe5b1c5..f1a7e3f 100644
--- a/src/interop_protocol.h
+++ b/src/interop_protocol.h
@@ -12,8 +12,11 @@
 #define MB_INTEROP_BULK_VERSION 7u
 /* Per-message bound, not an allocation/mapped-range limit. Fits the existing
  * renderer request buffer (512 KiB + 256); larger ranges use multiple writes. */
 #define MB_INTEROP_WRITE_MAX (512u * 1024u)
+/* Matched normal-session proxy/broker: persistent SHM staging only. Ordinary
+ * mappings/ring ranges and v6 retain their old limits. Still one ACK per write. */
+#define MB_INTEROP_STAGING_WRITE_MAX (2u * 1024u * 1024u)
 /* Existing broker reply bound, minus its 12-byte status/result/count prefix.
  * This is a message limit; larger mapped ranges use multiple bulk reads. */
 #define MB_INTEROP_READ_MAX (128u * 1024u - 12u)
 #define MB_MEMORY_WRITE_HEADER 20u
@@ -50,8 +53,12 @@
 #define MB_AHB_PRESENT 59u /* device,AHB,sync -> completed consumer handoff; no pixel copying */
 static inline uint32_t mb_interop_write_limit(uint32_t version) {
     return version >= MB_INTEROP_BULK_VERSION ? MB_INTEROP_WRITE_MAX : MB_INTEROP_CHUNK;
 }
+static inline uint32_t mb_interop_upload_limit(uint32_t version, int staging) {
+    return version >= MB_INTEROP_BULK_VERSION && staging ?
+        MB_INTEROP_STAGING_WRITE_MAX : mb_interop_write_limit(version);
+}
 static inline uint32_t mb_interop_read_limit(uint32_t version) {
     return version >= MB_INTEROP_BULK_VERSION ? MB_INTEROP_READ_MAX : MB_INTEROP_CHUNK;
 }
 /* Subtraction-based checks never evaluate offset+length or map_offset+map_size. */
@@ -60,9 +67,13 @@ static inline int mb_interop_mapped_range(uint64_t allocation, uint64_t map_offs
     return length && map_offset <= allocation && map_size <= allocation - map_offset &&
         offset >= map_offset && offset - map_offset <= map_size &&
         length <= map_size - (offset - map_offset);
 }
-static inline int mb_interop_write_size(uint32_t version, uint32_t bytes, uint64_t length) {
-    return bytes >= MB_MEMORY_WRITE_HEADER && length && length <= mb_interop_write_limit(version) &&
+static inline int mb_interop_write_size_for_mode(uint32_t version, int normal,
+        uint32_t bytes, uint64_t length) {
+    return bytes >= MB_MEMORY_WRITE_HEADER && length && length <= mb_interop_upload_limit(version, normal) &&
         length == bytes - MB_MEMORY_WRITE_HEADER;
 }
+static inline int mb_interop_write_size(uint32_t version, uint32_t bytes, uint64_t length) {
+    return mb_interop_write_size_for_mode(version, 0, bytes, length);
+}
 #endif
diff --git a/src/renderer_protocol.h b/src/renderer_protocol.h
index 82ca9f6..7c54613 100644
--- a/src/renderer_protocol.h
+++ b/src/renderer_protocol.h
@@ -1,10 +1,18 @@
 /* v7: isolated real Gamescope BLIT renderer subset. LE scalars; no native handles. */
 #ifndef DD_RENDERER_PROTOCOL_H
 #define DD_RENDERER_PROTOCOL_H
+#include "interop_protocol.h"
 #define MB_RENDERER_VERSION 7u
 #define MB_RENDERER_MAX_SHADER (512u * 1024u)
 #define MB_RENDERER_MAX_REQUEST (MB_RENDERER_MAX_SHADER + 256u)
+/* Transport storage, independent of shader/other opcode limits. Only normal
+ * memory writes can use the extra space; the decoded handler checks mode. */
+#define MB_BROKER_MAX_REQUEST (MB_MEMORY_WRITE_HEADER + MB_INTEROP_STAGING_WRITE_MAX)
+static inline uint32_t mb_broker_request_limit(uint32_t version, uint32_t op) {
+    return version == MB_RENDERER_VERSION && op == MB_MEMORY_WRITE ?
+        MB_BROKER_MAX_REQUEST : MB_RENDERER_MAX_REQUEST;
+}
 #define MB_RENDERER_MAX_OBJECTS 128u
 #define MB_RENDERER_MAX_DESCRIPTORS 64u
 #define MB_RENDERER_SEMAPHORE_CREATE 60u /* device,u64 initial -> ID */
 #define MB_RENDERER_DESTROY 61u /* device,kind,ID */
